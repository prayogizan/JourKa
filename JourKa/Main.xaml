                            <ui:InvokeCode ContinueOnError="{x:Null}" Code="System.IO.Directory.CreateDirectory(in_RoleFolder)&#xA;System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(in_PdfPath))&#xA;Dim apiKey As String = in_GeminiApiKey&#xA;If String.IsNullOrWhiteSpace(apiKey) OrElse apiKey = &quot;AIzaqwertyuiop&quot; Then&#xA;    Dim rootEnv As String = &quot;D:\UiPathProject\JourKa\.env&quot;&#xA;    If System.IO.File.Exists(rootEnv) Then&#xA;        apiKey = System.IO.File.ReadAllLines(rootEnv).Where(Function(l) l.Trim().StartsWith(&quot;GEMINI_API_KEY=&quot;, StringComparison.OrdinalIgnoreCase)).Select(Function(l) l.Trim().Substring(15).Trim()).FirstOrDefault()&#xA;    End If&#xA;End If&#xA;&#xA;Dim emDash As String = ChrW(&amp;H2014)&#xA;Dim modelCandidates As String() = New String() {&quot;gemini-3.5-flash-lite&quot;, &quot;gemini-flash-lite-latest&quot;}&#xA;&#xA;Using client As New System.Net.Http.HttpClient()&#xA;    client.Timeout = TimeSpan.FromSeconds(60)&#xA;    client.DefaultRequestHeaders.Add(&quot;User-Agent&quot;, &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64)&quot;)&#xA;&#xA;    ' 1. Scraping Job Boards SKILLSET for Entry-Level Role (LinkedIn Guest Search + Job Detail API) - UNCHANGED&#xA;    Dim liUrl As String = &quot;https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=&quot; &amp; Uri.EscapeDataString(in_RoleName) &amp; &quot;&amp;location=&quot; &amp; Uri.EscapeDataString(in_RoleLocation) &amp; &quot;&amp;f_E=2&amp;start=0&quot;&#xA;    Dim liHtml As String = &quot;&quot;&#xA;    Try&#xA;        liHtml = client.GetStringAsync(liUrl).GetAwaiter().GetResult()&#xA;    Catch&#xA;    End Try&#xA;    Dim jobMatches As System.Text.RegularExpressions.MatchCollection = System.Text.RegularExpressions.Regex.Matches(liHtml, &quot;(?s)data-entity-urn=&quot;&quot;urn:li:jobPosting:(\d+)&quot;&quot;.*?base-search-card__title[^&gt;]*&gt;\s*([^&lt;]+?)\s*&lt;/h3&gt;.*?base-search-card__subtitle[^&gt;]*&gt;\s*(?:&lt;a[^&gt;]*&gt;)?\s*([^&lt;]+?)\s*(?:&lt;/a&gt;)?\s*&lt;/h4&gt;.*?job-search-card__location[^&gt;]*&gt;\s*([^&lt;]+?)\s*&lt;/span&gt;&quot;)&#xA;    Dim jobLines As New System.Collections.Generic.List(Of String)()&#xA;    Dim jIdx As Integer = 1&#xA;    For Each m As System.Text.RegularExpressions.Match In jobMatches&#xA;        If jIdx &gt; 8 Then Exit For&#xA;        Dim jId As String = m.Groups(1).Value.Trim()&#xA;        Dim jTitle As String = System.Net.WebUtility.HtmlDecode(m.Groups(2).Value.Trim())&#xA;        Dim jComp As String = System.Net.WebUtility.HtmlDecode(m.Groups(3).Value.Trim())&#xA;        Dim jLoc As String = System.Net.WebUtility.HtmlDecode(m.Groups(4).Value.Trim())&#xA;        Dim jUrl As String = &quot;https://www.linkedin.com/jobs/view/&quot; &amp; jId&#xA;        Dim jSkillsSnippet As String = &quot;&quot;&#xA;        Try&#xA;            Dim detailHtml As String = client.GetStringAsync(&quot;https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/&quot; &amp; jId).GetAwaiter().GetResult()&#xA;            Dim dm As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(detailHtml, &quot;(?s)show-more-less-html__markup[^&gt;]*&gt;(.*?)&lt;/div&gt;&quot;)&#xA;            If dm.Success Then&#xA;                Dim rawDesc As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(dm.Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot; &quot;))&#xA;                rawDesc = System.Text.RegularExpressions.Regex.Replace(rawDesc, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;                If rawDesc.Length &gt; 550 Then rawDesc = rawDesc.Substring(0, 550) &amp; &quot;...&quot;&#xA;                jSkillsSnippet = &quot; | Scraped Skillset/Requirements: &quot; &amp; rawDesc&#xA;            End If&#xA;        Catch&#xA;        End Try&#xA;        jobLines.Add(&quot;[J&quot; &amp; jIdx.ToString(&quot;00&quot;) &amp; &quot;] Title: &quot; &amp; jTitle &amp; &quot; | Company: &quot; &amp; jComp &amp; &quot; | Location: &quot; &amp; jLoc &amp; jSkillsSnippet &amp; &quot; | URL: &quot; &amp; jUrl)&#xA;        jIdx += 1&#xA;    Next&#xA;&#xA;    ' 2. Scraping YouTube DAILY ROUTINE of That Role - UNCHANGED&#xA;    Dim ytUrl As String = &quot;https://www.youtube.com/results?search_query=&quot; &amp; Uri.EscapeDataString(&quot;day in the life of &quot; &amp; in_RoleName &amp; &quot; entry level&quot;) &amp; &quot;&amp;hl=en&quot;&#xA;    Dim ytHtml As String = &quot;&quot;&#xA;    Try&#xA;        ytHtml = client.GetStringAsync(ytUrl).GetAwaiter().GetResult()&#xA;    Catch&#xA;    End Try&#xA;    Dim ytBlocks As String() = ytHtml.Split(New String() {&quot;&quot;&quot;videoRenderer&quot;&quot;:{&quot;}, StringSplitOptions.None)&#xA;    Dim ytLines As New System.Collections.Generic.List(Of String)()&#xA;    Dim yIdx As Integer = 1&#xA;    For bIdx As Integer = 1 To ytBlocks.Length - 1&#xA;        If yIdx &gt; 8 Then Exit For&#xA;        Dim blk As String = ytBlocks(bIdx)&#xA;        Dim idM As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(blk, &quot;^&quot;&quot;videoId&quot;&quot;:&quot;&quot;([^&quot;&quot;]+)&quot;&quot;&quot;)&#xA;        Dim titleM As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(blk, &quot;&quot;&quot;title&quot;&quot;:\{&quot;&quot;runs&quot;&quot;:\[\{&quot;&quot;text&quot;&quot;:&quot;&quot;([^&quot;&quot;]+)&quot;&quot;\}&quot;)&#xA;        If idM.Success AndAlso titleM.Success Then&#xA;            Dim vId As String = idM.Groups(1).Value.Trim()&#xA;            Dim vTitle As String = titleM.Groups(1).Value.Trim()&#xA;            Dim vSnip As String = &quot;Public day-in-the-life routine video metadata&quot;&#xA;            Dim snipM As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(blk, &quot;&quot;&quot;detailedMetadataSnippets&quot;&quot;:\[\{&quot;&quot;snippetText&quot;&quot;:\{&quot;&quot;runs&quot;&quot;:\[(.*?)\]\}&quot;)&#xA;            If snipM.Success Then&#xA;                Dim parts As New System.Collections.Generic.List(Of String)()&#xA;                For Each rm As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(snipM.Groups(1).Value, &quot;&quot;&quot;text&quot;&quot;:&quot;&quot;([^&quot;&quot;]+)&quot;&quot;&quot;)&#xA;                    parts.Add(rm.Groups(1).Value)&#xA;                Next&#xA;                If parts.Count &gt; 0 Then vSnip = String.Join(&quot;&quot;, parts).Trim()&#xA;            End If&#xA;            Dim vUrl As String = &quot;https://www.youtube.com/watch?v=&quot; &amp; vId&#xA;            ytLines.Add(&quot;[Y&quot; &amp; yIdx.ToString(&quot;00&quot;) &amp; &quot;] Title: &quot; &amp; vTitle &amp; &quot; | Routine Summary: &quot; &amp; vSnip &amp; &quot; | URL: &quot; &amp; vUrl)&#xA;            yIdx += 1&#xA;        End If&#xA;    Next&#xA;&#xA;    ' Helper lambda: call Gemini with model failover&#xA;    Dim callGemini As Func(Of String, String, Integer, String) = Function(sysText As String, usrText As String, maxTok As Integer) As String&#xA;        Dim rJson As String = &quot;{&quot;&quot;system_instruction&quot;&quot;:{&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(sysText) &amp; &quot;}]},&quot;&quot;contents&quot;&quot;:[{&quot;&quot;role&quot;&quot;:&quot;&quot;user&quot;&quot;,&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(usrText) &amp; &quot;}]}],&quot;&quot;generationConfig&quot;&quot;:{&quot;&quot;temperature&quot;&quot;:0.3,&quot;&quot;maxOutputTokens&quot;&quot;:&quot; &amp; maxTok.ToString() &amp; &quot;}}&quot;&#xA;        For Each mdl As String In modelCandidates&#xA;            Try&#xA;                Dim ep As String = &quot;https://generativelanguage.googleapis.com/v1beta/models/&quot; &amp; mdl &amp; &quot;:generateContent&quot;&#xA;                Dim reqMsg As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, ep)&#xA;                reqMsg.Headers.Add(&quot;x-goog-api-key&quot;, apiKey)&#xA;                reqMsg.Content = New System.Net.Http.StringContent(rJson, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;                Dim respMsg As System.Net.Http.HttpResponseMessage = client.SendAsync(reqMsg).GetAwaiter().GetResult()&#xA;                Dim respBody As String = respMsg.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;                If respMsg.IsSuccessStatusCode Then&#xA;                    Dim txt As String = Newtonsoft.Json.Linq.JObject.Parse(respBody)(&quot;candidates&quot;)(0)(&quot;content&quot;)(&quot;parts&quot;)(0)(&quot;text&quot;).ToString().Trim()&#xA;                    txt = System.Text.RegularExpressions.Regex.Replace(txt, &quot;^```(?:markdown|md)?\s*&quot;, &quot;&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;                    txt = System.Text.RegularExpressions.Regex.Replace(txt, &quot;\s*```$&quot;, &quot;&quot;).Trim()&#xA;                    If Not String.IsNullOrWhiteSpace(txt) Then Return txt&#xA;                End If&#xA;            Catch&#xA;            End Try&#xA;        Next&#xA;        Return &quot;&quot;&#xA;    End Function&#xA;&#xA;    ' 3. Build EN Prompt (8 sections when no abroad evidence; 9 sections when verified abroad evidence exists)&#xA;    Dim hasAbroad As Boolean = (in_AbroadCount &gt; 0 AndAlso Not String.IsNullOrWhiteSpace(in_AbroadEvidenceText))&#xA;&#xA;    Dim editorialRules As String = &quot;EDITORIAL &amp; WRITING QUALITY RULES (CRITICAL): &quot; &amp; _&#xA;        &quot;(1) Write in a warm, articulate, candid, and deeply authoritative mentor voice -- adopting the exact senior professional persona appropriate for &quot; &amp; in_RoleName &amp; &quot; (e.g. Principal Engineer for tech/software, Creative Director for multimedia/design, Clinical Practice Director for healthcare/pharmacy, or Senior Practice Partner for business/finance) personally guiding an ambitious entry-level candidate in Indonesia. &quot; &amp; _&#xA;        &quot;(2) Make the dossier genuinely enjoyable and engaging for a human to read: combine structured reference tables (for quick scanning) with rich, well-explained narrative paragraphs that provide real-world context (why a competency matters in daily production, how a typical workday actually feels, concrete stories of career transitions, and practical insider advice). &quot; &amp; _&#xA;        &quot;(3) Avoid dry telegraphic summaries, shallow one-line bullet points, or robotic AI cliches (never use filler phrases like 'in today's fast-paced digital landscape', 'delve into', 'testament to', or 'moreover'). Whenever you use bullet points, write substantive 2-4 sentence explanations with concrete workplace examples. &quot; &amp; _&#xA;        &quot;(4) Ground every factual claim in the scraped evidence ([J01]..[J08], [Y01]..[Y08], and if provided [A01]..[A08]). Never fabricate URLs, companies, or quotes. Output ONLY clean Markdown without outer triple-backtick fences.&quot;&#xA;&#xA;    Dim commonSections1To7 As String = &quot;# [Role Name] &quot; &amp; emDash &amp; &quot; Entry-Level Career Dossier ([Market]) &quot; &amp; _&#xA;        &quot;## 1. Role Description &amp; Executive Overview (Open with a rich, engaging 2-3 paragraph narrative explaining what this entry-level role actually does behind the scenes in Indonesian companies, agencies, institutions, and high-growth enterprises in this sector -- and how your daily output impacts real end-users, patients, or clients. Detail Core Deliverables and Day-to-Day Collaboration with relevant cross-functional peers and senior mentors. Include a dedicated subsection '### Education &amp; Degree / Qualification [S1/D4] Verdict': state clearly whether a Bachelor's degree (S1/D4) or specific professional certification/license is Required, Strongly Preferred, or Optional in Indonesia; explain target majors and academic foundations that directly translate to workplace success; and provide a realistic guide to Alternative Non-Degree Paths via portfolio proof, industry certifications, bootcamps, and demonstrable projects.) &quot; &amp; _&#xA;        &quot;## 2. Entry-Level Skillset &amp; Core Competency Demand (Synthesize [J01]..[J08] into a comprehensive Markdown table with columns: Competency / Tool, Category, Market Demand Level, Real-World Workplace Usage &amp; Why It Matters, and Source Citations. Follow the table with a rich narrative subsection '### Hiring Manager's Perspective on Core Competencies' explaining how these tools and skills fit together in daily production, which 3-4 competencies carry 80% of hiring interview weight, and common beginner blind spots.) &quot; &amp; _&#xA;        &quot;## 3. What You Need to Learn: Step-by-Step Roadmap &amp; Portfolio Blueprints (Provide a clear visual roadmap diagram followed by thorough narrative walkthroughs of Phase 1 [Weeks 1-6: Core Foundations], Phase 2 [Weeks 7-12: Production Workflows &amp; Architecture], and Phase 3 [Weeks 13-16: Polish, Testing/Review &amp; Deployment/Delivery], explaining how to study effectively and what mastery looks like at each stage. Then detail 3 Concrete, Non-Trivial Portfolio Project Blueprints adapted to this role with real-world problem statements, complete tools/stacks used, workflow/architecture breakdowns, and specific hiring-manager evaluation criteria.) &quot; &amp; _&#xA;        &quot;## 4. Realistic Daily Routine: Day in the Life (Synthesize [Y01]..[Y08] into a detailed hour-by-hour Morning / Midday / Afternoon schedule table with citations, followed by a vivid, multi-paragraph narrative walkthrough of how a typical workday feels -- from morning alignment and deep-work execution blocks to peer collaboration, receiving feedback/critique, handling unforeseen roadblocks, and wrapping up sustainably.) &quot; &amp; _&#xA;        &quot;## 5. Expected Starting Salaries &amp; Career Progression (Provide a realistic Indonesian gross monthly salary table in IDR across [a] Local Startups / Boutique Agencies / SMEs / Local Clinics, [b] Mid-Sized Established Firms / Consultancies / Regional Hospitals, and [c] Top-Tier Unicorns / Multinationals / Conglomerates for Fresh Graduate/Entry-Level [0-1 yr], Junior [1-2 yrs], and Mid-Level [2-4 yrs], citing disclosed J-source data plus practical context on take-home pay, BPJS Ketenagakerjaan/Kesehatan, PPh 21, and THR. Follow with a visual End-to-End Career Journey &amp; Progression Map [Entry-Level -&gt; Junior -&gt; Mid-Level -&gt; Senior -&gt; Lead/Manager/Director] and rich stage-by-stage narrative paragraphs explaining how your scope, mindset, promotion criteria, and compensation evolve at each transition.) &quot; &amp; _&#xA;        &quot;## 6. Career Guidance: Real Pros, Real Cons &amp; Honest Industry Realities (Provide a detailed Pros vs. Cons comparison table, followed by a dedicated subsection '### AI Sentiment &amp; Future Outlook' with in-depth narrative analysis of AI replacement risk vs. augmentation potential in this field, how AI assistants and generative tools shift entry-level hiring expectations from repetitive execution toward verification, critical thinking, and system understanding, and 3-5 year career resilience. Then include '### Honest Industry Realities &amp; Who Thrives vs. Who Struggles' with candid mentor essays on real workplace constraints, the authentic Indonesian interview loop, and the habits of juniors who thrive vs. those who burn out.) &quot; &amp; _&#xA;        &quot;## 7. First 30 / 60 / 90-Day Onboarding Action Plan (Combine a structured milestone overview with a practical, mentor-style narrative playbook for Days 1-30 [Environment/Workspace Setup, Reading Existing Workflows &amp; First Small Wins], Days 31-60 [Independent Execution &amp; Building Team Trust], and Days 61-90 [End-to-End Ownership &amp; Passing Probation with Flying Colors].) &quot;&#xA;&#xA;    Dim sysPrompt As String = &quot;&quot;&#xA;    Dim usrPrompt As String = &quot;&quot;&#xA;    If Not hasAbroad Then&#xA;        sysPrompt = &quot;You are a seasoned Senior Hiring Manager and Career Mentor in Indonesia specializing in &quot; &amp; in_RoleName &amp; &quot;. Transform the raw scraped job-board skillset data ([J01]..[J08]) and YouTube daily routine data ([Y01]..[Y08]) into a thorough, comprehensive, and genuinely enjoyable-to-read GitHub-Flavored Markdown career dossier for an entry-level candidate. &quot; &amp; _&#xA;            editorialRules &amp; &quot; &quot; &amp; _&#xA;            &quot;Strictly include these 8 clearly structured sections: &quot; &amp; _&#xA;            commonSections1To7 &amp; _&#xA;            &quot;## 8. Verified Evidence &amp; Source Register (Full Markdown table listing all [J01]..[J08] and [Y01]..[Y08] sources with ID, Type, Title, Company/Context, and clickable Markdown URL).&quot;&#xA;        usrPrompt = &quot;TARGET ROLE: &quot; &amp; in_RoleName &amp; Environment.NewLine &amp; _&#xA;            &quot;TARGET LEVEL: &quot; &amp; in_RoleLevel &amp; Environment.NewLine &amp; _&#xA;            &quot;TARGET MARKET: &quot; &amp; in_RoleLocation &amp; Environment.NewLine &amp; _&#xA;            &quot;PRIORITY KEYWORDS: &quot; &amp; in_ExtraKeywords &amp; Environment.NewLine &amp; _&#xA;            &quot;RESEARCH DATE: &quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd&quot;) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;            &quot;=== SCRAPED JOB BOARDS SKILLSET EVIDENCE (LINKEDIN) ===&quot; &amp; Environment.NewLine &amp; _&#xA;            String.Join(Environment.NewLine, jobLines) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;            &quot;=== SCRAPED YOUTUBE DAILY ROUTINE EVIDENCE ===&quot; &amp; Environment.NewLine &amp; _&#xA;            String.Join(Environment.NewLine, ytLines) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;            &quot;Write the complete, deeply explained, human-friendly 8-section Markdown dossier now.&quot;&#xA;    Else&#xA;        sysPrompt = &quot;You are a seasoned Senior Hiring Manager and International Career Mentor in Indonesia specializing in &quot; &amp; in_RoleName &amp; &quot;. Transform the raw scraped job-board skillset data ([J01]..[J08]), YouTube daily routine data ([Y01]..[Y08]), and verified abroad visa-sponsored job data ([A01]..[A08]) into a thorough, comprehensive, and genuinely enjoyable-to-read GitHub-Flavored Markdown career dossier for an entry-level candidate. &quot; &amp; _&#xA;            editorialRules &amp; &quot; &quot; &amp; _&#xA;            &quot;Strictly include these 9 clearly structured sections: &quot; &amp; _&#xA;            commonSections1To7 &amp; _&#xA;            &quot;## 8. Abroad Entry-Level Opportunities with Visa Sponsorship (Include: [a] Markdown table of verified postings from [A01]..[A08] for target abroad markets [&quot; &amp; in_AbroadMarkets &amp; &quot;] with columns: ID, Role Title, Company, Country / City, Sponsorship Proof Quote, Salary [only if disclosed, otherwise 'Not disclosed'], and Link; [b] Detailed narrative &amp; country-specific work visa guide strictly for the target abroad countries configured in the Excel row [&quot; &amp; in_AbroadMarkets &amp; &quot;] and present in [A01]..[A08] -- do NOT include visa sections for countries outside [&quot; &amp; in_AbroadMarkets &amp; &quot;] -- labeled as general guidance to verify on official government immigration portals; [c] Candid comparison of international vs. Indonesian hiring bars covering language proficiency, degree recognition, and global technical interviews for [&quot; &amp; in_AbroadMarkets &amp; &quot;]; [d] Practical step-by-step application and relocation checklist for an Indonesian fresh graduate targeting [&quot; &amp; in_AbroadMarkets &amp; &quot;]. Only cite postings in [A01]..[A08]. Never invent abroad jobs, companies, salaries, or URLs.) &quot; &amp; _&#xA;            &quot;## 9. Verified Evidence &amp; Source Register (Full Markdown table listing all [J01]..[J08], [Y01]..[Y08], and [A01]..[A08] sources with ID, Type, Title, Company/Context, and clickable Markdown URL).&quot;&#xA;        usrPrompt = &quot;TARGET ROLE: &quot; &amp; in_RoleName &amp; Environment.NewLine &amp; _&#xA;            &quot;TARGET LEVEL: &quot; &amp; in_RoleLevel &amp; Environment.NewLine &amp; _&#xA;            &quot;TARGET MARKET: &quot; &amp; in_RoleLocation &amp; Environment.NewLine &amp; _&#xA;            &quot;TARGET ABROAD MARKETS (FROM EXCEL): &quot; &amp; in_AbroadMarkets &amp; Environment.NewLine &amp; _&#xA;            &quot;PRIORITY KEYWORDS: &quot; &amp; in_ExtraKeywords &amp; Environment.NewLine &amp; _&#xA;            &quot;RESEARCH DATE: &quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd&quot;) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;            &quot;=== SCRAPED JOB BOARDS SKILLSET EVIDENCE (LINKEDIN) ===&quot; &amp; Environment.NewLine &amp; _&#xA;            String.Join(Environment.NewLine, jobLines) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;            &quot;=== SCRAPED YOUTUBE DAILY ROUTINE EVIDENCE ===&quot; &amp; Environment.NewLine &amp; _&#xA;            String.Join(Environment.NewLine, ytLines) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;            &quot;=== VERIFIED ABROAD VISA-SPONSORED ENTRY-LEVEL EVIDENCE ===&quot; &amp; Environment.NewLine &amp; _&#xA;            in_AbroadEvidenceText &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;            &quot;Write the complete, deeply explained, human-friendly 9-section Markdown dossier now.&quot;&#xA;    End If&#xA;&#xA;    out_DossierMarkdown = callGemini(sysPrompt, usrPrompt, 16384)&#xA;    If String.IsNullOrWhiteSpace(out_DossierMarkdown) Then&#xA;        out_DossierMarkdown = &quot;# &quot; &amp; in_RoleName &amp; &quot; &quot; &amp; emDash &amp; &quot; Entry-Level Career Dossier (&quot; &amp; in_RoleLocation &amp; &quot;)&quot; &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;## 1. Collected Job Evidence&quot; &amp; Environment.NewLine &amp; String.Join(Environment.NewLine, jobLines.Select(Function(x) &quot;- &quot; &amp; x)) &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;## 2. Collected YouTube Routine Evidence&quot; &amp; Environment.NewLine &amp; String.Join(Environment.NewLine, ytLines.Select(Function(x) &quot;- &quot; &amp; x))&#xA;    End If&#xA;&#xA;    ' 4. Translate &amp; Adapt EN Dossier to Publication-Grade Bahasa Indonesia (ID) + Structure &amp; URL Validation&#xA;    Dim idSysPrompt As String = &quot;You are a senior Indonesian career journalist, industry practice leader, and mentor. Transform the provided English Markdown career dossier into publication-grade, natural, and deeply engaging Bahasa Indonesia. &quot; &amp; _&#xA;        &quot;EDITORIAL STYLE RULES FOR BAHASA INDONESIA: &quot; &amp; _&#xA;        &quot;(1) Write like a warm, articulate, and distinguished Indonesian mentor speaking directly to an ambitious reader (use natural 'Anda' and active Indonesian phrasing). The prose must flow like high-tier Indonesian professional journalism -- never stiff, literal, or word-for-word machine translation. &quot; &amp; _&#xA;        &quot;(2) Preserve the full depth, thorough narrative paragraphs, real-world examples, and mentor insights from the English dossier without summarizing or shortening any explanation. &quot; &amp; _&#xA;        &quot;(3) Keep standard industry, technical, and professional terms intact in English where Indonesian practitioners naturally use them (e.g., Kotlin, Jetpack Compose, Pull Request, Code Review, CI/CD, REST API, MVVM, Clean Architecture, Coroutines, Debugging, Tech Stack, Timeline, Color Grading, Footage, Compounding, Dispensing, Onboarding, Sprint, Daily Standup, Deployment, Refactoring). &quot; &amp; _&#xA;        &quot;(4) Strictly preserve: exact Markdown struc