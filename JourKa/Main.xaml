                                            <ui:InvokeCode ContinueOnError="{x:Null}" Code="System.IO.Directory.CreateDirectory(in_RoleFolder)&#xA;System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(in_PdfPath))&#xA;Dim apiKey As String = in_GeminiApiKey&#xA;If String.IsNullOrWhiteSpace(apiKey) OrElse apiKey = &quot;AIzaqwertyuiop&quot; Then&#xA;    Dim rootEnv As String = &quot;D:\UiPathProject\JourKa\.env&quot;&#xA;    If System.IO.File.Exists(rootEnv) Then&#xA;        apiKey = System.IO.File.ReadAllLines(rootEnv).Where(Function(l) l.Trim().StartsWith(&quot;GEMINI_API_KEY=&quot;, StringComparison.OrdinalIgnoreCase)).Select(Function(l) l.Trim().Substring(15).Trim()).FirstOrDefault()&#xA;    End If&#xA;End If&#xA;&#xA;Using client As New System.Net.Http.HttpClient()&#xA;    client.Timeout = TimeSpan.FromSeconds(90)&#xA;    client.DefaultRequestHeaders.Add(&quot;User-Agent&quot;, &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64)&quot;)&#xA;&#xA;    ' 1. Scraping Job Boards SKILLSET for Entry-Level Role (LinkedIn Guest Search + Job Detail API)&#xA;    Dim liUrl As String = &quot;https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=&quot; &amp; Uri.EscapeDataString(in_RoleName) &amp; &quot;&amp;location=&quot; &amp; Uri.EscapeDataString(in_RoleLocation) &amp; &quot;&amp;f_E=2&amp;start=0&quot;&#xA;    Dim liHtml As String = &quot;&quot;&#xA;    Try&#xA;        liHtml = client.GetStringAsync(liUrl).GetAwaiter().GetResult()&#xA;    Catch&#xA;    End Try&#xA;    Dim jobMatches As System.Text.RegularExpressions.MatchCollection = System.Text.RegularExpressions.Regex.Matches(liHtml, &quot;(?s)data-entity-urn=&quot;&quot;urn:li:jobPosting:(\d+)&quot;&quot;.*?base-search-card__title[^&gt;]*&gt;\s*([^&lt;]+?)\s*&lt;/h3&gt;.*?base-search-card__subtitle[^&gt;]*&gt;\s*(?:&lt;a[^&gt;]*&gt;)?\s*([^&lt;]+?)\s*(?:&lt;/a&gt;)?\s*&lt;/h4&gt;.*?job-search-card__location[^&gt;]*&gt;\s*([^&lt;]+?)\s*&lt;/span&gt;&quot;)&#xA;    Dim jobLines As New System.Collections.Generic.List(Of String)()&#xA;    Dim jIdx As Integer = 1&#xA;    For Each m As System.Text.RegularExpressions.Match In jobMatches&#xA;        If jIdx &gt; 8 Then Exit For&#xA;        Dim jId As String = m.Groups(1).Value.Trim()&#xA;        Dim jTitle As String = System.Net.WebUtility.HtmlDecode(m.Groups(2).Value.Trim())&#xA;        Dim jComp As String = System.Net.WebUtility.HtmlDecode(m.Groups(3).Value.Trim())&#xA;        Dim jLoc As String = System.Net.WebUtility.HtmlDecode(m.Groups(4).Value.Trim())&#xA;        Dim jUrl As String = &quot;https://www.linkedin.com/jobs/view/&quot; &amp; jId&#xA;        Dim jSkillsSnippet As String = &quot;&quot;&#xA;        Try&#xA;            Dim detailHtml As String = client.GetStringAsync(&quot;https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/&quot; &amp; jId).GetAwaiter().GetResult()&#xA;            Dim dm As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(detailHtml, &quot;(?s)show-more-less-html__markup[^&gt;]*&gt;(.*?)&lt;/div&gt;&quot;)&#xA;            If dm.Success Then&#xA;                Dim rawDesc As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(dm.Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot; &quot;))&#xA;                rawDesc = System.Text.RegularExpressions.Regex.Replace(rawDesc, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;                If rawDesc.Length &gt; 550 Then rawDesc = rawDesc.Substring(0, 550) &amp; &quot;...&quot;&#xA;                jSkillsSnippet = &quot; | Scraped Skillset/Requirements: &quot; &amp; rawDesc&#xA;            End If&#xA;        Catch&#xA;        End Try&#xA;        jobLines.Add(&quot;[J&quot; &amp; jIdx.ToString(&quot;00&quot;) &amp; &quot;] Title: &quot; &amp; jTitle &amp; &quot; | Company: &quot; &amp; jComp &amp; &quot; | Location: &quot; &amp; jLoc &amp; jSkillsSnippet &amp; &quot; | URL: &quot; &amp; jUrl)&#xA;        jIdx += 1&#xA;    Next&#xA;&#xA;    ' 2. Scraping YouTube DAILY ROUTINE of That Role&#xA;    Dim ytUrl As String = &quot;https://www.youtube.com/results?search_query=&quot; &amp; Uri.EscapeDataString(&quot;day in the life of &quot; &amp; in_RoleName &amp; &quot; entry level&quot;) &amp; &quot;&amp;hl=en&quot;&#xA;    Dim ytHtml As String = &quot;&quot;&#xA;    Try&#xA;        ytHtml = client.GetStringAsync(ytUrl).GetAwaiter().GetResult()&#xA;    Catch&#xA;    End Try&#xA;    Dim ytBlocks As String() = ytHtml.Split(New String() {&quot;&quot;&quot;videoRenderer&quot;&quot;:{&quot;}, StringSplitOptions.None)&#xA;    Dim ytLines As New System.Collections.Generic.List(Of String)()&#xA;    Dim yIdx As Integer = 1&#xA;    For bIdx As Integer = 1 To ytBlocks.Length - 1&#xA;        If yIdx &gt; 8 Then Exit For&#xA;        Dim blk As String = ytBlocks(bIdx)&#xA;        Dim idM As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(blk, &quot;^&quot;&quot;videoId&quot;&quot;:&quot;&quot;([^&quot;&quot;]+)&quot;&quot;&quot;)&#xA;        Dim titleM As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(blk, &quot;&quot;&quot;title&quot;&quot;:\{&quot;&quot;runs&quot;&quot;:\[\{&quot;&quot;text&quot;&quot;:&quot;&quot;([^&quot;&quot;]+)&quot;&quot;\}&quot;)&#xA;        If idM.Success AndAlso titleM.Success Then&#xA;            Dim vId As String = idM.Groups(1).Value.Trim()&#xA;            Dim vTitle As String = titleM.Groups(1).Value.Trim()&#xA;            Dim vSnip As String = &quot;Public day-in-the-life routine video metadata&quot;&#xA;            Dim snipM As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(blk, &quot;&quot;&quot;detailedMetadataSnippets&quot;&quot;:\[\{&quot;&quot;snippetText&quot;&quot;:\{&quot;&quot;runs&quot;&quot;:\[(.*?)\]\}&quot;)&#xA;            If snipM.Success Then&#xA;                Dim parts As New System.Collections.Generic.List(Of String)()&#xA;                For Each rm As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(snipM.Groups(1).Value, &quot;&quot;&quot;text&quot;&quot;:&quot;&quot;([^&quot;&quot;]+)&quot;&quot;&quot;)&#xA;                    parts.Add(rm.Groups(1).Value)&#xA;                Next&#xA;                If parts.Count &gt; 0 Then vSnip = String.Join(&quot;&quot;, parts).Trim()&#xA;            End If&#xA;            Dim vUrl As String = &quot;https://www.youtube.com/watch?v=&quot; &amp; vId&#xA;            ytLines.Add(&quot;[Y&quot; &amp; yIdx.ToString(&quot;00&quot;) &amp; &quot;] Title: &quot; &amp; vTitle &amp; &quot; | Routine Summary: &quot; &amp; vSnip &amp; &quot; | URL: &quot; &amp; vUrl)&#xA;            yIdx += 1&#xA;        End If&#xA;    Next&#xA;&#xA;    ' 3. Use LLM to Polish Raw Data into Easy-to-Read Markdown Dossier&#xA;    Dim sysPrompt As String = &quot;You are a senior tech career researcher and mentor. Transform the raw scraped job-board skillset data ([J01]..[J08]) and YouTube daily routine data ([Y01]..[Y08]) into a comprehensive, easy-to-read GitHub-Flavored Markdown career dossier for an entry-level candidate. &quot; &amp; _&#xA;        &quot;Strictly include these 8 clearly structured sections: &quot; &amp; _&#xA;        &quot;# [Role Name] — Entry-Level Career Dossier ([Market]) &quot; &amp; _&#xA;        &quot;## 1. Role Description &amp; Executive Overview (Generate a crystal-clear description of what this entry-level role actually does, core deliverables, and team collaboration) &quot; &amp; _&#xA;        &quot;## 2. Entry-Level Skillset &amp; Tech Stack Demand (Synthesize the scraped job-board skillset [J01]..[J08] into a Markdown table with Skill/Technology, Category, Demand Level, Why It Matters, and Source Citations) &quot; &amp; _&#xA;        &quot;## 3. What You Need to Learn: Step-by-Step Roadmap &amp; Portfolio Projects (Actionable 3-phase learning roadmap + 3 concrete portfolio project ideas with tech stack and hiring-manager evaluation criteria) &quot; &amp; _&#xA;        &quot;## 4. Realistic Daily Routine: Day in the Life (Synthesize the scraped YouTube routine evidence [Y01]..[Y08] into a realistic Morning / Midday / Afternoon schedule table and narrative) &quot; &amp; _&#xA;        &quot;## 5. Expected Starting Salaries &amp; Career Progression (Provide a clear Markdown table of realistic Indonesian tech market gross monthly salary ranges in IDR for Fresh Graduate/Entry-Level, Junior 1-2 yrs, and Mid-Level across Local Startups/SMEs, IT Consultancies, and Unicorns/Multinationals, noting any disclosed data from J-sources) &quot; &amp; _&#xA;        &quot;## 6. Career Guidance: Real Pros, Real Cons &amp; Honest Industry Realities (Provide a balanced Pros vs. Cons comparison table AND deep-dive bullet points on honest industry realities: legacy code, device/OS fragmentation, interview hurdles, AI coding tool impact, and Who Thrives vs. Who Struggles) &quot; &amp; _&#xA;        &quot;## 7. First 30 / 60 / 90-Day Onboarding Action Plan (Concrete milestones for surviving and excelling in the first 3 months) &quot; &amp; _&#xA;        &quot;## 8. Verified Evidence &amp; Source Register (Full Markdown table listing all [J01]..[J08] and [Y01]..[Y08] sources with ID, Type, Title, Company/Context, and clickable Markdown URL). &quot; &amp; _&#xA;        &quot;Never fabricate URLs. Output ONLY clean Markdown without outer triple-backtick fences.&quot;&#xA;    Dim usrPrompt As String = &quot;TARGET ROLE: &quot; &amp; in_RoleName &amp; Environment.NewLine &amp; _&#xA;        &quot;TARGET LEVEL: &quot; &amp; in_RoleLevel &amp; Environment.NewLine &amp; _&#xA;        &quot;TARGET MARKET: &quot; &amp; in_RoleLocation &amp; Environment.NewLine &amp; _&#xA;        &quot;PRIORITY KEYWORDS: &quot; &amp; in_ExtraKeywords &amp; Environment.NewLine &amp; _&#xA;        &quot;RESEARCH DATE: &quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd&quot;) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;        &quot;=== SCRAPED JOB BOARDS SKILLSET EVIDENCE (LINKEDIN) ===&quot; &amp; Environment.NewLine &amp; _&#xA;        String.Join(Environment.NewLine, jobLines) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;        &quot;=== SCRAPED YOUTUBE DAILY ROUTINE EVIDENCE ===&quot; &amp; Environment.NewLine &amp; _&#xA;        String.Join(Environment.NewLine, ytLines) &amp; Environment.NewLine &amp; Environment.NewLine &amp; _&#xA;        &quot;Polish this raw evidence into the complete 8-section Markdown dossier now.&quot;&#xA;    Dim reqJson As String = &quot;{&quot;&quot;system_instruction&quot;&quot;:{&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(sysPrompt) &amp; &quot;}]},&quot;&quot;contents&quot;&quot;:[{&quot;&quot;role&quot;&quot;:&quot;&quot;user&quot;&quot;,&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(usrPrompt) &amp; &quot;}]}],&quot;&quot;generationConfig&quot;&quot;:{&quot;&quot;temperature&quot;&quot;:0.25}}&quot;&#xA;&#xA;    out_DossierMarkdown = &quot;&quot;&#xA;    Dim modelCandidates As String() = New String() {&quot;gemini-3.5-flash&quot;, &quot;gemini-3.8-flash&quot;, &quot;gemini-3.1-flash-lite&quot;, &quot;gemini-3.5-flash-lite&quot;}&#xA;    For Each mdl As String In modelCandidates&#xA;        Try&#xA;            Dim ep As String = &quot;https://generativelanguage.googleapis.com/v1beta/models/&quot; &amp; mdl &amp; &quot;:generateContent&quot;&#xA;            Dim reqMsg As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, ep)&#xA;            reqMsg.Headers.Add(&quot;x-goog-api-key&quot;, apiKey)&#xA;            reqMsg.Content = New System.Net.Http.StringContent(reqJson, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;            Dim respMsg As System.Net.Http.HttpResponseMessage = client.SendAsync(reqMsg).GetAwaiter().GetResult()&#xA;            Dim respBody As String = respMsg.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;            If respMsg.IsSuccessStatusCode Then&#xA;                out_DossierMarkdown = Newtonsoft.Json.Linq.JObject.Parse(respBody)(&quot;candidates&quot;)(0)(&quot;content&quot;)(&quot;parts&quot;)(0)(&quot;text&quot;).ToString().Trim()&#xA;                If Not String.IsNullOrWhiteSpace(out_DossierMarkdown) Then Exit For&#xA;            End If&#xA;        Catch&#xA;        End Try&#xA;    Next&#xA;&#xA;    If String.IsNullOrWhiteSpace(out_DossierMarkdown) Then&#xA;        out_DossierMarkdown = &quot;# &quot; &amp; in_RoleName &amp; &quot; — Entry-Level Career Dossier (&quot; &amp; in_RoleLocation &amp; &quot;)&quot; &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;## Collected Job Evidence&quot; &amp; Environment.NewLine &amp; String.Join(Environment.NewLine, jobLines.Select(Function(x) &quot;- &quot; &amp; x)) &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;## Collected YouTube Routine Evidence&quot; &amp; Environment.NewLine &amp; String.Join(Environment.NewLine, ytLines.Select(Function(x) &quot;- &quot; &amp; x))&#xA;    End If&#xA;End Using&#xA;&#xA;' 4. Convert Markdown File into Polished PDF File&#xA;System.IO.File.WriteAllText(in_MarkdownPath, out_DossierMarkdown, System.Text.Encoding.UTF8)&#xA;Dim html As String = &quot;&lt;!DOCTYPE html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;title&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleName) &amp; &quot; - Career Dossier&lt;/title&gt;&quot; &amp; _&#xA;    &quot;&lt;style&gt;&quot; &amp; _&#xA;    &quot;@page { size: A4; margin: 16mm 15mm 16mm 15mm; }&quot; &amp; _&#xA;    &quot;body { font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif; line-height: 1.62; color: #1e293b; max-width: 860px; margin: 0 auto; padding: 0; font-size: 13.5px; }&quot; &amp; _&#xA;    &quot;.banner { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color: #ffffff; padding: 24px 28px; border-radius: 10px; margin-bottom: 22px; }&quot; &amp; _&#xA;    &quot;.banner h1 { color: #ffffff; border: none; margin: 0 0 8px 0; padding: 0; font-size: 24px; letter-spacing: -0.3px; }&quot; &amp; _&#xA;    &quot;.banner .meta { font-size: 12.5px; color: #cbd5e1; display: flex; flex-wrap: wrap; gap: 14px; }&quot; &amp; _&#xA;    &quot;.banner .pill { background: rgba(255,255,255,0.14); padding: 3px 10px; border-radius: 999px; font-weight: 600; color: #f8fafc; }&quot; &amp; _&#xA;    &quot;h1 { font-size: 22px; color: #0f172a; border-bottom: 2px solid #cbd5e1; padding-bottom: 6px; margin-top: 24px; }&quot; &amp; _&#xA;    &quot;h2 { font-size: 16.5px; color: #1e3a8a; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px; margin-top: 22px; page-break-after: avoid; }&quot; &amp; _&#xA;    &quot;h3 { font-size: 14.5px; color: #0f172a; margin-top: 16px; page-break-after: avoid; }&quot; &amp; _&#xA;    &quot;p, li { color: #334155; }&quot; &amp; _&#xA;    &quot;ul, ol { padding-left: 20px; }&quot; &amp; _&#xA;    &quot;li { margin-bottom: 4px; }&quot; &amp; _&#xA;    &quot;table { border-collapse: collapse; width: 100%; margin: 14px 0 18px 0; font-size: 12.2px; page-break-inside: auto; }&quot; &amp; _&#xA;    &quot;tr { page-break-inside: avoid; page-break-after: auto; }&quot; &amp; _&#xA;    &quot;th, td { border: 1px solid #cbd5e1; padding: 8px 10px; text-align: left; vertical-align: top; }&quot; &amp; _&#xA;    &quot;th { background: #f1f5f9; color: #0f172a; font-weight: 700; }&quot; &amp; _&#xA;    &quot;tr:nth-child(even) td { background: #f8fafc; }&quot; &amp; _&#xA;    &quot;blockquote { border-left: 4px solid #2563eb; background: #eff6ff; margin: 14px 0; padding: 10px 14px; border-radius: 0 6px 6px 0; color: #1e3a8a; }&quot; &amp; _&#xA;    &quot;code { background: #f1f5f9; padding: 2px 5px; border-radius: 4px; font-family: Consolas, monospace; font-size: 12px; color: #0f172a; }&quot; &amp; _&#xA;    &quot;a { color: #2563eb; text-decoration: none; word-break: break-all; }&quot; &amp; _&#xA;    &quot;&lt;/style&gt;&lt;script src='https://cdn.jsdelivr.net/npm/marked/marked.min.js'&gt;&lt;/script&gt;&lt;/head&gt;&lt;body&gt;&quot; &amp; _&#xA;    &quot;&lt;div class='banner'&gt;&lt;h1&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleName) &amp; &quot; — Career Intelligence Dossier&lt;/h1&gt;&quot; &amp; _&#xA;    &quot;&lt;div class='meta'&gt;&lt;span class='pill'&gt;Level: &quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleLevel) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;    &quot;&lt;span class='pill'&gt;Market: &quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleLocation) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;    &quot;&lt;span class='pill'&gt;Focus: &quot; &amp; System.Net.WebUtility.HtmlEncode(in_ExtraKeywords) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;    &quot;&lt;span class='pill'&gt;Generated: &quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd&quot;) &amp; &quot;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&quot; &amp; _&#xA;    &quot;&lt;div id='c'&gt;&lt;/div&gt;&lt;textarea id='m' style='display:none;'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(out_DossierMarkdown) &amp; &quot;&lt;/textarea&gt;&quot; &amp; _&#xA;    &quot;&lt;script&gt;document.getElementById('c').innerHTML=marked.parse(document.getElementById('m').value);&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;&quot;&#xA;System.IO.File.WriteAllText(in_HtmlPath, html, System.Text.Encoding.UTF8)&#xA;Dim psi As New System.Diagnostics.ProcessStartInfo(&quot;C:\Program Files\Google\Chrome\Application\chrome.exe&quot;, &quot;--headless --disable-gpu --no-pdf-header-footer --virtual-time-budget=4000 --print-to-pdf=&quot;&quot;&quot; &amp; in_PdfPath &amp; &quot;&quot;&quot; &quot;&quot;&quot; &amp; in_HtmlPath &amp; &quot;&quot;&quot;&quot;)&#xA;psi.UseShellExecute = False&#xA;psi.CreateNoWindow = True&#xA;Using p As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)&#xA;    p.WaitForExit(60000)&#xA;End Using&#xA;Dim localRolePdf As String