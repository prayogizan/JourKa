ords), &quot;&quot;, &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblFocus &amp; in_ExtraKeywords) &amp; &quot;&lt;/span&gt;&quot;)&#xA;    Dim abroadPill As String = &quot;&quot;&#xA;    If in_AbroadCount &gt; 0 Then&#xA;        Dim abroadTxt As String = If(isId, &quot;Luar Negeri (&quot; &amp; in_AbroadMarkets &amp; &quot;): &quot; &amp; in_AbroadCount.ToString() &amp; &quot; terverifikasi&quot;, &quot;Abroad (&quot; &amp; in_AbroadMarkets &amp; &quot;): &quot; &amp; in_AbroadCount.ToString() &amp; &quot; verified&quot;)&#xA;        abroadPill = &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(abroadTxt) &amp; &quot;&lt;/span&gt;&quot;&#xA;    End If&#xA;    Dim html As String = &quot;&lt;!DOCTYPE html&gt;&lt;html lang='&quot; &amp; langCode &amp; &quot;'&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;title&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleName &amp; docTitleSuffix) &amp; &quot;&lt;/title&gt;&quot; &amp; _&#xA;        &quot;&lt;style&gt;&quot; &amp; _&#xA;        &quot;@page { size: A4; margin: 16mm 15mm 16mm 15mm; }&quot; &amp; _&#xA;        &quot;body { font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif; line-height: 1.68; color: #1e293b; max-width: 860px; margin: 0 auto; padding: 0; font-size: 13.5px; }&quot; &amp; _&#xA;        &quot;.banner { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color: #ffffff; padding: 24px 28px; border-radius: 10px; margin-bottom: 22px; }&quot; &amp; _&#xA;        &quot;.banner h1 { color: #ffffff; border: none; margin: 0 0 8px 0; padding: 0; font-size: 24px; letter-spacing: -0.3px; }&quot; &amp; _&#xA;        &quot;.banner .meta { font-size: 12.5px; color: #cbd5e1; display: flex; flex-wrap: wrap; gap: 14px; }&quot; &amp; _&#xA;        &quot;.banner .pill { background: rgba(255,255,255,0.14); padding: 3px 10px; border-radius: 999px; font-weight: 600; color: #f8fafc; }&quot; &amp; _&#xA;        &quot;h1 { font-size: 22px; color: #0f172a; border-bottom: 2px solid #cbd5e1; padding-bottom: 6px; margin-top: 24px; }&quot; &amp; _&#xA;        &quot;h2 { font-size: 16.5px; color: #1e3a8a; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px; margin-top: 24px; page-break-after: avoid; }&quot; &amp; _&#xA;        &quot;h3 { font-size: 14.5px; color: #0f172a; margin-top: 18px; page-break-after: avoid; }&quot; &amp; _&#xA;        &quot;p { color: #334155; margin: 10px 0; text-align: left; }&quot; &amp; _&#xA;        &quot;li { color: #334155; margin-bottom: 6px; }&quot; &amp; _&#xA;        &quot;ul, ol { padding-left: 22px; margin: 8px 0 14px 0; }&quot; &amp; _&#xA;        &quot;table { border-collapse: collapse; width: 100%; margin: 14px 0 18px 0; font-size: 12.2px; page-break-inside: auto; }&quot; &amp; _&#xA;        &quot;tr { page-break-inside: avoid; page-break-after: auto; }&quot; &amp; _&#xA;        &quot;th, td { border-collapse: collapse; border: 1px solid #cbd5e1; padding: 8px 10px; text-align: left; vertical-align: top; }&quot; &amp; _&#xA;        &quot;th { background: #f1f5f9; color: #0f172a; font-weight: 700; }&quot; &amp; _&#xA;        &quot;tr:nth-child(even) td { background: #f8fafc; }&quot; &amp; _&#xA;        &quot;blockquote { border-left: 4px solid #2563eb; background: #eff6ff; margin: 14px 0; padding: 10px 14px; border-radius: 0 6px 6px 0; color: #1e3a8a; }&quot; &amp; _&#xA;        &quot;code { background: #f1f5f9; padding: 2px 5px; border-radius: 4px; font-family: Consolas, monospace; font-size: 12px; color: #0f172a; }&quot; &amp; _&#xA;        &quot;a { color: #2563eb; text-decoration: none; word-break: break-all; }&quot; &amp; _&#xA;        &quot;&lt;/style&gt;&lt;script src='https://cdn.jsdelivr.net/npm/marked/marked.min.js'&gt;&lt;/script&gt;&lt;/head&gt;&lt;body&gt;&quot; &amp; _&#xA;        &quot;&lt;div class='banner'&gt;&lt;h1&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleName &amp; &quot; &quot; &amp; emDash &amp; &quot; &quot; 