ot; &amp; in_RoleLocation &amp; &quot;)&quot; &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;## 1. Collected Job Evidence&quot; &amp; Environment.NewLine &amp; String.Join(Environment.NewLine, jobLines.Select(Function(x) &quot;- &quot; &amp; x)) &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;## 2. Collected YouTube Routine Evidence&quot; &amp; Environment.NewLine &amp; String.Join(Environment.NewLine, ytLines.Select(Function(x) &quot;- &quot; &amp; x))&#xA;    End If&#xA;&#xA;    ' 4. Translate &amp; Adapt EN Dossier to Publication-Grade Bahasa Indonesia (ID) + Structure &amp; URL Validation&#xA;    Dim idSysPrompt As String = &quot;You are a senior Indonesian career journalist, industry practice leader, and mentor. Transform the provided English Markdown career dossier into publication-grade, natural, and deeply engaging Bahasa Indonesia. &quot; &amp; _&#xA;        &quot;EDITORIAL STYLE RULES FOR BAHASA INDONESIA: &quot; &amp; _&#xA;        &quot;(1) Write like a warm, articulate, and distinguished Indonesian mentor speaking directly to an ambitious reader (use natural 'Anda' and active Indonesian phrasing). The prose must flow like high-tier Indonesian professional journalism -- never stiff, literal, or word-for-word machine translation. &quot; &amp; _&#xA;        &quot;(2) Preserve the full depth, thorough narrative paragraphs, real-world examples, and mentor insights from the English dossier without summarizing or shortening any explanation. &quot; &amp; _&#xA;        &quot;(3) Keep standard industry, technical, and professional terms intact in English where Indonesian practitioners naturally use them (e.g., Kotlin, Jetpack Compose, Pull Request, Code Review, CI/CD, REST API, MVVM, Clean Architecture, Coroutines, Debugging, Tech Stack, Timeline, Color Grading, Footage, Compounding, Dispensing, Onboarding, Sprint, Daily Standup, Deployment, Refactoring). &quot; &amp; _&#xA;        &quot;(4) Strictly preserve: exact Markdown structure and exact number of '## ' level-2 headings, all Markdown tables and column counts, all source IDs ([J01], [Y01], [A01], etc.), all URLs verbatim, and all company names, salary figures, and currency codes. &quot; &amp; _&#xA;        &quot;(5) Use natural Indonesian section headings: '## 1. Deskripsi Peran &amp; Ringkasan Eksekutif', '## 2. Kebutuhan Kompetensi &amp; Keahlian Entry-Level', '## 3. Peta Jalan Belajar &amp; Proyek Portofolio', '## 4. Rutinitas Harian Realistis: Keseharian Kerja', '## 5. Estimasi Gaji Awal &amp; Peta Perjalanan Karier', '## 6. Panduan Karier: Pro, Kontra, Sentimen AI &amp; Realita Industri', '## 7. Rencana Aksi Onboarding 30 / 60 / 90 Hari Pertama', and if present '## 8. Peluang Kerja Entry-Level di Luar Negeri dengan Sponsor Visa', plus 'Daftar Bukti &amp; Sumber Terverifikasi'. &quot; &amp; _&#xA;        &quot;Output ONLY clean Markdown without outer triple-backtick code fences.&quot;&#xA;    Dim idUsrPrompt As String = &quot;Adapt and translate the following English Markdown career dossier into rich, natural, publication-grade Bahasa Indonesia while keeping the exact heading count, full narrative depth, table structures, source IDs, and URLs 100% intact:&quot; &amp; Environment.NewLine &amp; Environment.NewLine &amp; out_DossierMarkdown&#xA;&#xA;    Dim enH2Count As Integer = System.Text.RegularExpressions.Regex.Matches(out_DossierMarkdown, &quot;(?m)^##\s+&quot;).Count&#xA;    Dim enUrls As New System.Collections.Generic.HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;    For Each um As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(out_DossierMarkdown, &quot;https?://[^\s\)\]&gt;&quot;&quot;]+&quot;)&#xA;        enUrls.Add(um.Value.TrimEnd(&quot;.&quot;c, &quot;,&quot;c))&#xA;    Next&#xA;&#xA;    out_DossierMarkdownID = &quot;&quot;&#xA;    Dim idJson As String = &quot;{&quot;&quot;system_instruction&quot;&quot;:{&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(idSysPrompt) &amp; &quot;}]},&quot;&quot;contents&quot;&quot;:[{&quot;&quot;role&quot;&quot;:&quot;&quot;user&quot;&quot;,&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(idUsrPrompt) &amp; &quot;}]}],&quot;&quot;generationConfig&quot;&quot;:{&quot;&quot;temperature&quot;&quot;:0.25,&quot;&quot;maxOutputTokens&quot;&quot;:16384}}&quot;&#xA;    For Each mdl As String In modelCandidates&#xA;        Try&#xA;            Dim ep As String = &quot;https://generativelanguage.googleapis.com/v1beta/models/&quot; &amp; mdl &amp; &quot;:generateContent&quot;&#xA;            Dim reqMsg As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, ep)&#xA;            reqMsg.Headers.Add(&quot;x-goog-api-key&quot;, apiKey)&#xA;            reqMsg.Content = New System.Net.Http.StringContent(idJson, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;            Dim respMsg As System.Net.Http.HttpResponseMessage = client.SendAsync(reqMsg).GetAwaiter().GetResult()&#xA;            Dim respBody As String = respMsg.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;            If respMsg.IsSuccessStatusCode Then&#xA;                Dim candidateIdMd As String = Newtonsoft.Json.Linq.JObject.Parse(respBody)(&quot;candidates&quot;)(0)(&quot;content&quot;)(&quot;parts&quot;)(0)(&quot;text&quot;).ToString().Trim()&#xA;                candidateIdMd = System.Text.RegularExpressions.Regex.Replace(candidateIdMd, &quot;^```(?:markdown|md)?\s*&quot;, &quot;&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;                candidateIdMd = System.Text.RegularExpressions.Regex.Replace(candidateIdMd, &quot;\s*```$&quot;, &quot;&quot;).Trim()&#xA;                Dim idH2Count As Integer = System.Text.RegularExpressions.Regex.Matches(candidateIdMd, &quot;(?m)^##\s+&quot;).Count&#xA;                Dim urlsOk As Boolean = True&#xA;                For Each u As String In enUrls&#xA;                    If candidateIdMd.IndexOf(u, StringComparison.OrdinalIgnoreCase) &lt; 0 Then&#xA;                        urlsOk = False&#xA;                        Exit For&#xA;                    End If&#xA;                Next&#xA;                If Not String.IsNullOrWhiteSpace(candidateIdMd) Then&#xA;                    If idH2Count = enH2Count AndAlso urlsOk Then&#xA;                        out_DossierMarkdownID = candidateIdMd&#xA;                        Exit For&#xA;                    ElseIf String.IsNullOrWhiteSpace(out_DossierMarkdownID) Then&#xA;                        out_DossierMarkdownID = candidateIdMd&#xA;                    End If&#xA;                End If&#xA;            End If&#xA;        Catch&#xA;        End Try&#xA;    Next&#xA;End Using&#xA;&#xA;' 5. Helper lambda: Publish Markdown -&gt; Styled HTML -&gt; Chrome Headless PDF&#xA;Dim publishDossier As Action(Of String, String, String, String, String) = Sub(mdContent As String, mdFile As String, htmlFile As String, pdfFile As String, langCode As String)&#xA;    If String.IsNullOrWhiteSpace(mdContent) Then Return&#xA;    System.IO.File.WriteAllText(mdFile, mdContent, System.Text.Encoding.UTF8)&#xA;    Dim isId As Boolean = String.Equals(langCode, &quot;id&quot;, StringComparison.OrdinalIgnoreCase)&#xA;    Dim docTitleSuffix As String = If(isId, &quot; - Dosier Karier (ID)&quot;, &quot; - Career Dossier (EN)&quot;)&#xA;    Dim bannerSuffix As String = If(isId, &quot;Dosier Intelijen Karier&quot;, &quot;Career Intelligence Dossier&quot;)&#xA;    Dim lblMarket As String = If(isId, &quot;Pasar: &quot;, &quot;Market: &quot;)&#xA;    Dim lblFocus As String = If(isId, &quot;Fokus: &quot;, &quot;Focus: &quot;)&#xA;    Dim lblGen As String = If(isId, &quot;Dibuat: &quot;, &quot;Generated: &quot;)&#xA;    Dim lblLang As String = If(isId, &quot;Bahasa: Indonesia&quot;, &quot;Language: English&quot;)&#xA;    Dim focusPill As String = If(String.IsNullOrWhiteSpace(in_ExtraKeywords), &quot;&quot;, &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblFocus &amp; in_ExtraKeywords) &amp; &quot;&lt;/span&gt;&quot;)&#xA;    Dim abroadPill As String = &quot;&quot;&#xA;    If in_AbroadCount &gt; 0 Then&#xA;        Dim abroadTxt As String = If(isId, &quot;Luar Negeri (&quot; &amp; in_AbroadMarkets &amp; &quot;): &quot; &amp; in_AbroadCount.ToString() &amp; &quot; terverifikasi&quot;, &quot;Abroad (&quot; &amp; in_AbroadMarkets &amp; &quot;): &quot; &amp; in_AbroadCount.ToString() &amp; &quot; verified&quot;)&#xA;        abroadPill = &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(abroadTxt) &amp; &quot;&lt;/span&gt;&quot;&#xA;    End If&#xA;    Dim metaPillsHtml As String = &quot;&lt;span class='pill'&gt;Level: &quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleLevel) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;        &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblMarket &amp; in_RoleLocation) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;        focusPill &amp; _&#xA;        &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblLang) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;        abroadPill &amp; _&#xA;        &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblGen &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd&quot;)) &amp; &quot;&lt;/span&gt;&quot;&#xA;    Dim htmlFileName As String = System.IO.Path.GetFileName(htmlFile)&#xA;    Dim counterpartFile As String = If(isId, htmlFileName.Replace(&quot; - ID.html&quot;, &quot; - EN.html&quot;), htmlFileName.Replace(&quot; - EN.html&quot;, &quot; - ID.html&quot;))&#xA;    If String.Equals(counterpartFile, htmlFileName, StringComparison.OrdinalIgnoreCase) Then&#xA;        counterpartFile = System.IO.Path.GetFileNameWithoutExtension(htmlFileName) &amp; If(isId, &quot; - EN.html&quot;, &quot; - ID.html&quot;)&#xA;    End If&#xA;    Dim counterpartHref As String = System.Net.WebUtility.HtmlEncode(System.Uri.EscapeDataString(counterpartFile))&#xA;    Dim counterpartLabel As String = If(isId, &quot;EN&quot;, &quot;ID&quot;)&#xA;    Dim tplContent As String = &quot;&quot;&#xA;    Dim tplCandidates As String() = New String() { _&#xA;        System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Templates&quot;, &quot;DossierInteractiveTemplate.html&quot;), _&#xA;        System.IO.Path.GetFullPath(System.IO.Path.Combine(in_RoleFolder, &quot;..&quot;, &quot;..&quot;, &quot;Templates&quot;, &quot;DossierInteractiveTemplate.html&quot;)) _&#xA;    }&#xA;    For Each tplCandidate As String In tplCandidates&#xA;        If System.IO.File.Exists(tplCandidate) Then&#xA;            Try&#xA;                tplContent = System.IO.File.ReadAllText(tplCandidate, System.Text.Encoding.UTF8)&#xA;                If Not String.IsNullOrWhiteSpace(tplContent) Then Exit For&#xA;            Catch&#xA;                tplContent = &quot;&quot;&#xA;            End Try&#xA;        End If&#xA;    Next&#xA;    If String.IsNullOrWhiteSpace(tplContent) Then&#xA;        tplContent = &quot;&lt;!DOCTYPE html&gt;&lt;html lang='{{LANG_CODE}}' data-jourka-ui='v2-fallback' data-jourka-template='inline-fallback'&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;title&gt;{{DOC_TITLE}}&lt;/title&gt;&lt;style&gt;body{font-family:'Segoe UI',Arial,sans-serif;line-height:1.68;color:#1e293b;max-width:860px;margin:24px auto;padding:0 16px;}.banner{background:linear-gradient(135deg,#0f172a 0%,#1e3a8a 100%);color:#fff;padding:20px 24px;border-radius:10px;margin-bottom:20px;}.banner h1{margin:0 0 8px 0;font-size:22px;color:#fff;}.meta{display:flex;flex-wrap:wrap;gap:10px;font-size:12px;}.pill{background:rgba(255,255,255,0.16);padding:3px 10px;border-radius:999px;}&lt;/style&gt;&lt;script src='https://cdn.jsdelivr.net/npm/marked/marked.min.js'&gt;&lt;/script&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='banner'&gt;&lt;h1&gt;{{ROLE_NAME}} &quot; &amp; emDash &amp; &quot; {{BANNER_SUFFIX}}&lt;/h1&gt;&lt;div class='meta'&gt;{{META_PILLS_HTML}} &lt;a class='pill' style='color:#fff;' href='{{COUNTERPART_HREF}}'&gt;{{COUNTERPART_LABEL}}&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id='c'&gt;&lt;/div&gt;&lt;textarea id='m' style='display:none;'&gt;{{MARKDOWN_ENCODED}}&lt;/textarea&gt;&lt;script&gt;if(window.marked){document.getElementById('c').innerHTML=marked.parse(document.getElementById('m').value);}&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;&quot;&#xA;    End If&#xA;    Dim interactiveHtml As String = tplContent _&#xA;        .Replace(&quot;{{LANG_CODE}}&quot;, langCode) _&#xA;        .Replace(&quot;{{DOC_TITLE}}&quot;, System.Net.WebUtility.HtmlEncode(in_RoleName &amp; docTitleSuffix)) _&#xA;        .Replace(&quot;{{ROLE_NAME}}&quot;, System.Net.WebUtility.HtmlEncode(in_RoleName)) _&#xA;        .Replace(&quot;{{BANNER_SUFFIX}}&quot;, System.Net.WebUtility.HtmlEncode(bannerSuffix)) _&#xA;        .Replace(&quot;{{META_PILLS_HTML}}&quot;, metaPillsHtml) _&#xA;        .Replace(&quot;{{COUNTERPART_HREF}}&quot;, counterpartHref) _&#xA;        .Replace(&quot;{{COUNTERPART_LABEL}}&quot;, counterpartLabel) _&#xA;        .Replace(&quot;{{MARKDOWN_ENCODED}}&quot;, System.Net.WebUtility.HtmlEncode(mdContent))&#xA;    System.IO.File.WriteAllText(htmlFile, interactiveHtml, System.Text.Encoding.UTF8)&#xA;&#xA;    Dim legacyPdfHtml As String = &quot;&lt;!DOCTYPE html&gt;&lt;html lang='&quot; &amp; langCode &amp; &quot;'&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;title&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleName &amp; docTitleSuffix) &amp; &quot;&lt;/title&gt;&quot; &amp; _&#xA;        &quot;&lt;style&gt;&quot; &amp; _&#xA;        &quot;@page { size: A4; margin: 16mm 15mm 16mm 15mm; }&quot; &amp; _&#xA;        &quot;body { font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif; line-height: 1.68; color: #1e293b; max-width: 860px; margin: 0 auto; padding: 0; font-size: 13.5px; }&quot; &amp; _&#xA;        &quot;.banner { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color: #ffffff; padding: 24px 28px; border-radius: 10px; margin-bottom: 22px; }&quot; &amp; _&#xA;        &quot;.banner h1 { color: #ffffff; border: none; margin: 0 0 8px 0; padding: 0; font-size: 24px; letter-spacing: -0.3px; }&quot; &amp; _&#xA;        &quot;.banner .meta { font-size: 12.5px; color: #cbd5e1; display: flex; flex-wrap: wrap; gap: 14px; }&quot; &amp; _&#xA;        &quot;.banner .pill { background: rgba(255,255,255,0.14); padding: 3px 10px; border-radius: 999px; font-weight: 600; color: #f8fafc; }&quot; &amp; _&#xA;        &quot;h1 { font-size: 22px; color: #0f172a; border-bottom: 2px solid #cbd5e1; padding-bottom: 6px; margin-top: 24px; }&quot; &amp; _&#xA;        &quot;h2 { font-size: 16.5px; color: #1e3a8a; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px; margin-top: 24px; page-break-after: avoid; }&quot; &amp; _&#xA;        &quot;h3 { font-size: 14.5px; color: #0f172a; margin-top: 18px; page-break-after: avoid; }&quot; &amp; _&#xA;        &quot;p { color: #334155; margin: 10px 0; text-align: left; }&quot; &amp; _&#xA;        &quot;li { color: #334155; margin-bottom: 6px; }&quot; &amp; _&#xA;        &quot;ul, ol { padding-left: 22px; margin: 8px 0 14px 0; }&quot; &amp; _&#xA;        &quot;table { border-collapse: collapse; width: 100%; margin: 14px 0 18px 0; font-size: 12.2px; page-break-inside: auto; }&quot; &amp; _&#xA;        &quot;tr { page-break-inside: avoid; page-break-after: auto; }&quot; &amp; _&#xA;        &quot;th, td { border-collapse: collapse; border: 1px solid #cbd5e1; padding: 8px 10px; text-align: left; vertical-align: top; }&quot; &amp; _&#xA;        &quot;th { background: #f1f5f9; color: #0f172a; font-weight: 700; }&quot; &amp; _&#xA;        &quot;tr:nth-child(even) td { background: #f8fafc; }&quot; &amp; _&#xA;        &quot;blockquote { border-left: 4px solid #2563eb; background: #eff6ff; margin: 14px 0; padding: 10px 14px; border-radius: 0 6px 6px 0; color: #1e3a8a; }&quot; &amp; _&#xA;        &quot;code { background: #f1f5f9; padding: 2px 5px; border-radius: 4px; font-family: Consolas, monospace; font-size: 12px; color: #0f172a; }&quot; &amp; _&#xA;        &quot;a { color: #2563eb; text-decoration: none; word-break: break-all; }&quot; &amp; _&#xA;        &quot;&lt;/style&gt;&lt;script src='https://cdn.jsdelivr.net/npm/marked/marked.min.js'&gt;&lt;/script&gt;&lt;/head&gt;&lt;body&gt;&quot; &amp; _&#xA;        &quot;&lt;div class='banner'&gt;&lt;h1&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleName &amp; &quot; &quot; &amp; emDash &amp; &quot; &quot; &amp; bannerSuffix) &amp; &quot;&lt;/h1&gt;&quot; &amp; _&#xA;        &quot;&lt;div class='meta'&gt;&lt;span class='pill'&gt;Level: &quot; &amp; System.Net.WebUtility.HtmlEncode(in_RoleLevel) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;        &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblMarket &amp; in_RoleLocation) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;        focusPill &amp; _&#xA;        &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblLang) &amp; &quot;&lt;/span&gt;&quot; &amp; _&#xA;        abroadPill &amp; _&#xA;        &quot;&lt;span class='pill'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(lblGen &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd&quot;)) &amp; &quot;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&quot; &amp; _&#xA;        &quot;&lt;div id='c'&gt;&lt;/div&gt;&lt;textarea id='m' style='display:none;'&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(mdContent) &amp; &quot;&lt;/textarea&gt;&quot; &amp; _&#xA;        &quot;&lt;script&gt;document.getElementById('c').innerHTML=marked.parse(document.getElementById('m').value);&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;&quot;&#xA;    Dim tmpPdfHtml As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;jourka_pdf_&quot; &amp; Guid.NewGuid().ToString(&quot;N&quot;) &amp; &quot;.html&quot;)&#xA;    Try&#xA;        System.IO.File.WriteAllText(tmpPdfHtml, legacyPdfHtml, System.Text.Encoding.UTF8)&#xA;        Dim psi As New System.Diagnostics.ProcessStartInfo(&quot;C:\Program Files\Google\Chrome\Application\chrome.exe&quot;, &quot;--headless --disable-gpu --no-pdf-header-footer --virtual-time-budget=4000 --print-to-pdf=&quot;&quot;&quot; &amp; pdfFile &amp; &quot;&quot;&quot; &quot;&quot;&quot; &amp; tmpPdfHtml &amp; &quot;&quot;&quot;&quot;)&#xA;        psi.UseShellExecute = False&#xA;        psi.CreateNoWindow = True&#xA;        Using p As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)&#xA;            If Not p.WaitForExit(60000) Then&#xA;                Try&#xA;                    p.Kill(True)&#xA;                    p.WaitForExit(5000)&#xA;                Catch&#xA;                End Try&#xA;            End If&#xA;        End Using&#xA;        Dim localRolePdf As String = System.IO.Path.Combine(in_RoleFolder, System.IO.Path.GetFileName(pdfFile))&#xA;        If System.IO.File.Exists(pdfFile) AndAlso Not String.Equals(pdfFile, localRolePdf, StringComparison.OrdinalIgnoreCase) Then&#xA;            System.IO.File.Copy(pdfFile, localRolePdf, True)&#xA;        End If&#xA;    Finally&#xA;        Try&#xA;            If System.IO.File.Exists(tmpPdfHtml) Then&#xA;                System.IO.File.Delete(tmpPdfHtml)&#xA;            End If&#xA;        Catch&#xA;        End Try&#xA;    End Try&#xA;End Sub&#xA;&#xA;publishDossier(out_DossierMarkdown, in_MarkdownPath, in_HtmlPath, in_PdfPath, &quot;en&quot;)&#xA;If Not String.IsNullOrWhiteSpace(out_DossierMarkdownID) Then&#xA;    publishDossier(out_DossierMarkdownID, in_MarkdownPathID, in_HtmlPathID, in_PdfPathID, &quot;id&quot;)&#xA;End If" DisplayName="Collect Evidence, Call Google AI Studio (EN+ID) &amp; Export PDFs" sap:VirtualizedContainerService.HintSize="338,165" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="VBNet">
