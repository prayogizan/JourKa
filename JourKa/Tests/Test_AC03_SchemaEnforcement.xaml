  <Sequence DisplayName="Test_AC03_SchemaEnforcement" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="legacyPath" />
      <Variable x:TypeArguments="x:String" Name="roleVTwoPath" />
      <Variable x:TypeArguments="x:Boolean" Default="False" Name="breThrown" />
      <Variable x:TypeArguments="x:String" Default="" Name="breMessage" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_VTwo" />
    </Sequence.Variables>
    <Sequence DisplayName="... Given" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <Assign DisplayName="Resolve Legacy V1 Fixture Path" sap2010:WorkflowViewState.IdRef="Assign_1">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[legacyPath]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(Environment.CurrentDirectory, "Tests", "Data", "Desire Role List - LegacyV1Schema.xlsx")]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign DisplayName="Resolve V2 Fixture Path" sap2010:WorkflowViewState.IdRef="Assign_2">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[roleVTwoPath]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(Environment.CurrentDirectory, "Tests", "Data", "Desire Role List - E2E UAT.xlsx")]</InArgument>
        </Assign.Value>
      </Assign>
      <uta:VerifyExpression AlternativeVerificationTitle="Fixture workbooks exist on disk" ContinueOnFailure="False" DisplayName="Verify Test Fixtures Exist" Expression="[System.IO.File.Exists(legacyPath) AndAlso System.IO.File.Exists(roleVTwoPath)]" OutputMessageFormat="Legacy and v2 fixture existence: {Result}" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False" sap2010:WorkflowViewState.IdRef="VerifyExpression_1" />
    </Sequence>
    <Sequence DisplayName="... When" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <TryCatch DisplayName="Invoke Main.xaml Against Legacy V1 Workbook (Expect Fatal BRE)" sap2010:WorkflowViewState.IdRef="TryCatch_1">
        <TryCatch.Try>
          <Sequence DisplayName="Run Main with Legacy V1 Schema" sap2010:WorkflowViewState.IdRef="Sequence_4">
            <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Main.xaml (Legacy V1)" UnSafe="False" WorkflowFileName="Main.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1">
              <ui:InvokeWorkflowFile.Arguments>
                <InArgument x:TypeArguments="x:String" x:Key="in_WorkbookPath">[legacyPath]</InArgument>
              </ui:InvokeWorkflowFile.Arguments>
            </ui:InvokeWorkflowFile>
          </Sequence>
        </TryCatch.Try>
        <TryCatch.Catches>
          <Catch x:TypeArguments="ui:BusinessRuleException" sap2010:WorkflowViewState.IdRef="Catch`1_1">
            <ActivityAction x:TypeArguments="ui:BusinessRuleException">
              <ActivityAction.Argument>
                <DelegateInArgument x:TypeArguments="ui:BusinessRuleException" Name="breEx" />
              </ActivityAction.Argument>
              <Sequence DisplayName="Capture Expected Schema BusinessRuleException" sap2010:WorkflowViewState.IdRef="Sequence_5">
                <Assign DisplayName="Mark breThrown True" sap2010:WorkflowViewState.IdRef="Assign_3">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">[breThrown]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign DisplayName="Capture BRE Message" sap2010:WorkflowViewState.IdRef="Assign_4">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[breMessage]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[breEx.Message]</InArgument>
                  </Assign.Value>
                </Assign>
                <ui:LogMessage DisplayName="Log Expected E1 Fatal Schema BRE" Level="Info" Message="[&quot;[AC-03/E1] Caught expected BusinessRuleException: &quot; &amp; breEx.Message]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
              </Sequence>
            </ActivityAction>
          </Catch>
          <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_2">
            <ActivityAction x:TypeArguments="s:Exception">
              <ActivityAction.Argument>
                <DelegateInArgument x:TypeArguments="s:Exception" Name="sysEx" />
              </ActivityAction.Argument>
              <Sequence DisplayName="Inspect Unwrapped Exception for BusinessRuleException" sap2010:WorkflowViewState.IdRef="Sequence_6">
                <If Condition="[TypeOf sysEx Is UiPath.Core.BusinessRuleException OrElse (sysEx.InnerException IsNot Nothing AndAlso TypeOf sysEx.InnerException Is UiPath.Core.BusinessRuleException)]" DisplayName="If Direct or Wrapped BusinessRuleException" sap2010:WorkflowViewState.IdRef="If_1">
                  <If.Then>
                    <Sequence DisplayName="Record Wrapped BusinessRuleException" sap2010:WorkflowViewState.IdRef="Sequence_8">
                      <Assign DisplayName="Mark Wrapped breThrown True" sap2010:WorkflowViewState.IdRef="Assign_6">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Boolean">[breThrown]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign DisplayName="Capture Unwrapped BRE Message" sap2010:WorkflowViewState.IdRef="Assign_7">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[breMessage]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[If(TypeOf sysEx Is UiPath.Core.BusinessRuleException, sysEx.Message, sysEx.InnerException.Message)]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <ui:LogMessage DisplayName="Log Unwrapped E1 Fatal Schema BRE" Level="Info" Message="[&quot;[AC-03/E1] Caught wrapped BusinessRuleException: &quot; &amp; breMessage]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
                    </Sequence>
                  </If.Then>
                  <If.Else>
                    <Sequence DisplayName="Record Unexpected Non-BRE Exception" sap2010:WorkflowViewState.IdRef="Sequence_9">
                      <Assign DisplayName="Record Non-BRE Error Message" sap2010:WorkflowViewState.IdRef="Assign_5">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[breMessage]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[sysEx.GetType().FullName &amp; ": " &amp; sysEx.Message]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Else>
                </If>
              </Sequence>
            </ActivityAction>
          </Catch>
        </TryCatch.Catches>
      </TryCatch>
      <ui:ReadRange Range="{x:Null}" WorkbookPathResource="{x:Null}" AddHeaders="True" DataTable="[dt_VTwo]" DisplayName="Read V2 Schema Fixture for Column Shift Check" SheetName="Sheet1" WorkbookPath="[roleVTwoPath]" sap2010:WorkflowViewState.IdRef="ReadRange_1" />
    </Sequence>
    <Sequence DisplayName="... Then" sap2010:WorkflowViewState.IdRef="Sequence_7">
      <uta:VerifyExpression AlternativeVerificationTitle="AC-03/E1: Legacy v1 schema throws BusinessRuleException" ContinueOnFailure="False" DisplayName="Verify BusinessRuleException Thrown" Expression="[breThrown]" OutputMessageFormat="BusinessRuleException thrown on Legacy V1 schema: {Result}" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False" sap2010:WorkflowViewState.IdRef="VerifyExpression_2" />
      <uta:VerifyExpressionWithOperator AlternativeVerificationTitle="AC-03/E1: BRE message cites RecipientEmail" ContinueOnFailure="False" DisplayName="Verify BRE Message Cites RecipientEmail" Operator="Contains" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False" sap2010:WorkflowViewState.IdRef="VerifyExpressionWithOperator_1">
        <uta:VerifyExpressionWithOperator.FirstExpression>
