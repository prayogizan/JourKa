        </uta:VerifyExpressionWithOperator.FirstExpression>
        <uta:VerifyExpressionWithOperator.SecondExpression>
          <InArgument x:TypeArguments="x:String">["RecipientEmail"]</InArgument>
        </uta:VerifyExpressionWithOperator.SecondExpression>
      </uta:VerifyExpressionWithOperator>
      <uta:VerifyExpression AlternativeVerificationTitle="AC-03: Rightward shift places RecipientEmail=0, Job=1, AbroadMarkets=2, StudentName=3" ContinueOnFailure="False" DisplayName="Verify V2 Column Ordinals and Name Lookups" Expression="[dt_VTwo.Columns(0).ColumnName.Equals(&quot;RecipientEmail&quot;, StringComparison.Ordinal) AndAlso dt_VTwo.Columns(&quot;Job&quot;).Ordinal = 1 AndAlso dt_VTwo.Columns(&quot;AbroadMarkets&quot;).Ordinal = 2 AndAlso dt_VTwo.Columns(&quot;StudentName&quot;).Ordinal = 3 AndAlso Convert.ToString(dt_VTwo.Rows(0)(&quot;Job&quot;)).Trim() = &quot;Android Developer&quot; AndAlso Convert.ToString(dt_VTwo.Rows(1)(&quot;AbroadMarkets&quot;)).Trim() = &quot;Singapore, Malaysia, United Kingdom&quot;]" OutputMessageFormat="V2 rightward column-shift schema verification: {Result}" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False" sap2010:WorkflowViewState.IdRef="VerifyExpression_3" />
    </Sequence>
  </Sequence>
