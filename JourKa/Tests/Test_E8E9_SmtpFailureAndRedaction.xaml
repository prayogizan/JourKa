          <Sequence DisplayName="... Given" sap2010:WorkflowViewState.IdRef="Sequence_3">
            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Guard no real .env files shadow Process env vars, create 0-byte temp file, and start mock 535 SMTP server&#xA;Dim envRoot As String = System.IO.Path.GetFullPath(System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;..&quot;, &quot;.env&quot;))&#xA;Dim envProj As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;.env&quot;)&#xA;If System.IO.File.Exists(envRoot) OrElse System.IO.File.Exists(envProj) Then&#xA;    Throw New System.InvalidOperationException(&quot;Real .env file detected; remove or move .env before running offline SMTP mock tests.&quot;)&#xA;End If&#xA;&#xA;Dim tmpZero As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;jourka_test_zero_&quot; &amp; System.Guid.NewGuid().ToString(&quot;N&quot;) &amp; &quot;.pdf&quot;)&#xA;System.IO.File.WriteAllBytes(tmpZero, New Byte() {})&#xA;out_ZeroBytePdfPath = tmpZero&#xA;&#xA;Dim keys As String() = New String() {&quot;SMTP_HOST&quot;, &quot;SMTP_PORT&quot;, &quot;SMTP_USER&quot;, &quot;SMTP_PASSWORD&quot;, &quot;SMTP_FROM&quot;, &quot;SMTP_SENDER_NAME&quot;}&#xA;Dim saved As New System.Collections.Generic.Dictionary(Of String, String)()&#xA;For Each k As String In keys&#xA;    saved(k) = System.Environment.GetEnvironmentVariable(k, System.EnvironmentVariableTarget.Process)&#xA;Next&#xA;out_SavedProcessEnv = saved&#xA;&#xA;Dim listener As New System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback, 0)&#xA;listener.Start()&#xA;Dim port As Integer = CType(listener.LocalEndpoint, System.Net.IPEndPoint).Port&#xA;Dim cts As New System.Threading.CancellationTokenSource()&#xA;&#xA;Dim serverTask As System.Threading.Tasks.Task = System.Threading.Tasks.Task.Run(Sub()&#xA;    While Not cts.IsCancellationRequested&#xA;        Try&#xA;            If Not listener.Pending() Then&#xA;                System.Threading.Thread.Sleep(25)&#xA;                Continue While&#xA;            End If&#xA;            Using client As System.Net.Sockets.TcpClient = listener.AcceptTcpClient()&#xA;                client.ReceiveTimeout = 5000&#xA;                client.SendTimeout = 5000&#xA;                Using ns As System.Net.Sockets.NetworkStream = client.GetStream()&#xA;                    Using sr As New System.IO.StreamReader(ns, System.Text.Encoding.ASCII, False, 1024, True)&#xA;                        Using sw As New System.IO.StreamWriter(ns, System.Text.Encoding.ASCII, 1024, True)&#xA;                            sw.NewLine = vbCrLf&#xA;                            sw.AutoFlush = True&#xA;                            sw.WriteLine(&quot;220 localhost ESMTP Mock535&quot;)&#xA;                            While True&#xA;                                Dim line As String = sr.ReadLine()&#xA;                                If line Is Nothing Then Exit While&#xA;                                Dim upper As String = line.Trim().ToUpperInvariant()&#xA;                                If upper.StartsWith(&quot;EHLO&quot;) OrElse upper.StartsWith(&quot;HELO&quot;) Then&#xA;                                    sw.WriteLine(&quot;250-localhost&quot;)&#xA;                                    sw.WriteLine(&quot;250 AUTH PLAIN LOGIN&quot;)&#xA;                                ElseIf upper.StartsWith(&quot;AUTH&quot;) Then&#xA;                                    sw.WriteLine(&quot;535 5.7.8 Authentication failed for secret-user-xyz with dummy-smtp-pass-999&quot;)&#xA;                                ElseIf upper.StartsWith(&quot;QUIT&quot;) Then&#xA;                                    sw.WriteLine(&quot;221 Bye&quot;)&#xA;                                    Exit While&#xA;                                Else&#xA;                                    sw.WriteLine(&quot;502 Command not implemented&quot;)&#xA;                                End If&#xA;                            End While&#xA;                        End Using&#xA;                    End Using&#xA;                End Using&#xA;            End Using&#xA;        Catch&#xA;        End Try&#xA;    End While&#xA;End Sub)&#xA;&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_HOST&quot;, &quot;127.0.0.1&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_PORT&quot;, port.ToString(), System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_USER&quot;, &quot;secret-user-xyz&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_PASSWORD&quot;, &quot;dummy-smtp-pass-999&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_FROM&quot;, &quot;counselor@jourka.test&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_SENDER_NAME&quot;, &quot;JourKa Test Runner&quot;, System.EnvironmentVariableTarget.Process)&#xA;&#xA;out_Listener = listener&#xA;out_Cts = cts&#xA;out_ServerTask = serverTask&#xA;" DisplayName="Setup 0-Byte Temp PDF and Mock 535 SMTP Server" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="VBNet">
