            <uta:VerifyExpression AlternativeVerificationTitle="E8/E9: SMTP 535 failure returns out_Success=False with redacted credentials" ContinueOnFailure="False" DisplayName="Verify SMTP 535 Failure and Secret Redaction" Expression="[(Not success535) AndAlso error535.Contains(&quot;535&quot;) AndAlso (Not error535.Contains(&quot;dummy-smtp-pass-999&quot;)) AndAlso (Not error535.Contains(&quot;secret-user-xyz&quot;)) AndAlso error535.Contains(&quot;[REDACTED]&quot;) AndAlso error535.Contains(&quot;[REDACTED_SMTP_USER]&quot;)]" OutputMessageFormat="SMTP 535 failure &amp; redaction verified: {Result}" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False" sap2010:WorkflowViewState.IdRef="VerifyExpression_2" />
