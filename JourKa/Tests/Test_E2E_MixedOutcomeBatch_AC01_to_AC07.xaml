            <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Run 1: Execute Main.xaml Mixed-Outcome Batch" UnSafe="False" WorkflowFileName="Main.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1">
