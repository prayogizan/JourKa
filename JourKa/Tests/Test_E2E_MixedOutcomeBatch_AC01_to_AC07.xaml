            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Setup isolated temp workbook copy, ForcedZeroByteRole 0-byte PDF fixture, and loopback SMTP capture server&#xA;Dim envRoot As String = System.IO.Path.GetFullPath(System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;..&quot;, &quot;.env&quot;))&#xA;Dim envProj As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;.env&quot;)&#xA;If System.IO.File.Exists(envRoot) OrElse System.IO.File.Exists(envProj) Then&#xA;    Throw New System.InvalidOperationException(&quot;Real .env file detected; remove or move .env before running offline E2E capture tests.&quot;)&#xA;End If&#xA;&#xA;Dim srcWorkbook As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Tests&quot;, &quot;Data&quot;, &quot;Desire Role List - E2E UAT.xlsx&quot;)&#xA;If Not System.IO.File.Exists(srcWorkbook) Then&#xA;    Throw New System.IO.FileNotFoundException(&quot;Missing E2E UAT workbook fixture: &quot; &amp; srcWorkbook, srcWorkbook)&#xA;End If&#xA;Dim tmpWb As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;jourka_e2e_uat_&quot; &amp; System.Guid.NewGuid().ToString(&quot;N&quot;) &amp; &quot;.xlsx&quot;)&#xA;System.IO.File.Copy(srcWorkbook, tmpWb, True)&#xA;out_TempWorkbookPath = tmpWb&#xA;&#xA;' Seed ForcedZeroByteRole fixture (EN/ID MD &gt; 2500 bytes + HTML v2 + 0-byte PDFs) so E7/AC-07 runs offline with 0 LLM calls&#xA;Dim forcedOutDir As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Output&quot;, &quot;ForcedZeroByteRole&quot;)&#xA;System.IO.Directory.CreateDirectory(forcedOutDir)&#xA;Dim filler As String = New String(&quot;A&quot;c, 2700)&#xA;System.IO.File.WriteAllText(System.IO.Path.Combine(forcedOutDir, &quot;ForcedZeroByteRole - EN.md&quot;), &quot;# ForcedZeroByteRole&quot; &amp; Environment.NewLine &amp; filler, System.Text.Encoding.UTF8)&#xA;System.IO.File.WriteAllText(System.IO.Path.Combine(forcedOutDir, &quot;ForcedZeroByteRole - ID.md&quot;), &quot;# ForcedZeroByteRole&quot; &amp; Environment.NewLine &amp; filler, System.Text.Encoding.UTF8)&#xA;System.IO.File.WriteAllText(System.IO.Path.Combine(forcedOutDir, &quot;ForcedZeroByteRole - EN.html&quot;), &quot;&lt;!DOCTYPE html&gt;&lt;html lang=&quot;&quot;en&quot;&quot; data-jourka-ui=&quot;&quot;v2&quot;&quot;&gt;&lt;body&gt;Forced&lt;/body&gt;&lt;/html&gt;&quot;, System.Text.Encoding.UTF8)&#xA;System.IO.File.WriteAllText(System.IO.Path.Combine(forcedOutDir, &quot;ForcedZeroByteRole - ID.html&quot;), &quot;&lt;!DOCTYPE html&gt;&lt;html lang=&quot;&quot;id&quot;&quot; data-jourka-ui=&quot;&quot;v2&quot;&quot;&gt;&lt;body&gt;Forced&lt;/body&gt;&lt;/html&gt;&quot;, System.Text.Encoding.UTF8)&#xA;&#xA;Dim pdfDir As String = &quot;D:\UiPathProject\JourKa\PDF_Results&quot;&#xA;System.IO.Directory.CreateDirectory(pdfDir)&#xA;Dim fPdfEn As String = System.IO.Path.Combine(pdfDir, &quot;ForcedZeroByteRole - EN.pdf&quot;)&#xA;Dim fPdfId As String = System.IO.Path.Combine(pdfDir, &quot;ForcedZeroByteRole - ID.pdf&quot;)&#xA;System.IO.File.WriteAllBytes(fPdfEn, New Byte() {})&#xA;System.IO.File.WriteAllBytes(fPdfId, New Byte() {})&#xA;out_ForcedRoleOutDir = forcedOutDir&#xA;out_ForcedPdfEn = fPdfEn&#xA;out_ForcedPdfId = fPdfId&#xA;&#xA;Dim outRoot As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Output&quot;)&#xA;out_BaselineCsvs = System.IO.Directory.GetFiles(outRoot, &quot;EmailAudit_*.csv&quot;).ToList()&#xA;&#xA;Dim keys As String() = New String() {&quot;SMTP_HOST&quot;, &quot;SMTP_PORT&quot;, &quot;SMTP_USER&quot;, &quot;SMTP_PASSWORD&quot;, &quot;SMTP_FROM&quot;, &quot;SMTP_SENDER_NAME&quot;}&#xA;Dim saved As New System.Collections.Generic.Dictionary(Of String, String)()&#xA;For Each k As String In keys&#xA;    saved(k) = System.Environment.GetEnvironmentVariable(k, System.EnvironmentVariableTarget.Process)&#xA;Next&#xA;out_SavedProcessEnv = saved&#xA;&#xA;' Thread-safe capture store: Item1 = RcptTo List, Item2 = RawMimeMessage&#xA;Dim captured As New System.Collections.Generic.List(Of System.Tuple(Of System.Collections.Generic.List(Of String), String))()&#xA;Dim captureLock As New System.Object()&#xA;Dim listener As New System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback, 0)&#xA;listener.Start()&#xA;Dim port As Integer = CType(listener.LocalEndpoint, System.Net.IPEndPoint).Port&#xA;Dim cts As New System.Threading.CancellationTokenSource()&#xA;&#xA;Dim serverTask As System.Threading.Tasks.Task = System.Threading.Tasks.Task.Run(Sub()&#xA;    While Not cts.IsCancellationRequested&#xA;        Try&#xA;            If Not listener.Pending() Then&#xA;                System.Threading.Thread.Sleep(20)&#xA;                Continue While&#xA;            End If&#xA;            Using client As System.Net.Sockets.TcpClient = listener.AcceptTcpClient()&#xA;                client.ReceiveTimeout = 10000&#xA;                client.SendTimeout = 10000&#xA;                Using ns As System.Net.Sockets.NetworkStream = client.GetStream()&#xA;                    Using sr As New System.IO.StreamReader(ns, System.Text.Encoding.UTF8, False, 4096, True)&#xA;                        Using sw As New System.IO.StreamWriter(ns, System.Text.Encoding.ASCII, 1024, True)&#xA;                            sw.NewLine = vbCrLf&#xA;                            sw.AutoFlush = True&#xA;                            sw.WriteLine(&quot;220 localhost ESMTP JourKaCapture&quot;)&#xA;                            Dim currentRcpts As New System.Collections.Generic.List(Of String)()&#xA;                            Dim authStep As Integer = 0&#xA;                            While True&#xA;                                Dim line As String = sr.ReadLine()&#xA;                                If line Is Nothing Then Exit While&#xA;                                If authStep = 1 Then&#xA;                                    authStep = 2&#xA;                                    sw.WriteLine(&quot;334 UGFzc3dvcmQ6&quot;)&#xA;                                    Continue While&#xA;                                ElseIf authStep = 2 Then&#xA;                                    authStep = 0&#xA;                                    sw.WriteLine(&quot;235 2.7.0 Authentication successful&quot;)&#xA;                                    Continue While&#xA;                                End If&#xA;                                Dim upper As String = line.Trim().ToUpperInvariant()&#xA;                                If upper.StartsWith(&quot;EHLO&quot;) OrElse upper.StartsWith(&quot;HELO&quot;) Then&#xA;                                    sw.WriteLine(&quot;250-localhost&quot;)&#xA;                                    sw.WriteLine(&quot;250-SIZE 52428800&quot;)&#xA;                                    sw.WriteLine(&quot;250-8BITMIME&quot;)&#xA;                                    sw.WriteLine(&quot;250 AUTH PLAIN LOGIN&quot;)&#xA;                                ElseIf upper.StartsWith(&quot;AUTH LOGIN&quot;) AndAlso line.Trim().Length &lt;= 10 Then&#xA;                                    authStep = 1&#xA;                                    sw.WriteLine(&quot;334 VXNlcm5hbWU6&quot;)&#xA;                                ElseIf upper.StartsWith(&quot;AUTH&quot;) Then&#xA;                                    sw.WriteLine(&quot;235 2.7.0 Authentication successful&quot;)&#xA;                                ElseIf upper.StartsWith(&quot;MAIL FROM:&quot;) Then&#xA;                                    currentRcpts = New System.Collections.Generic.List(Of String)()&#xA;                                    sw.WriteLine(&quot;250 2.1.0 Ok&quot;)&#xA;                                ElseIf upper.StartsWith(&quot;RCPT TO:&quot;) Then&#xA;                                    Dim mAddr As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(line, &quot;&lt;([^&gt;]+)&gt;&quot;)&#xA;                                    Dim addr As String = If(mAddr.Success, mAddr.Groups(1).Value.Trim(), line.Substring(8).Trim())&#xA;                                    currentRcpts.Add(addr)&#xA;                                    sw.WriteLine(&quot;250 2.1.5 Ok&quot;)&#xA;                                ElseIf upper = &quot;DATA&quot; Then&#xA;                                    sw.WriteLine(&quot;354 End data with &lt;CR&gt;&lt;LF&gt;.&lt;CR&gt;&lt;LF&gt;&quot;)&#xA;                                    Dim sbMime As New System.Text.StringBuilder()&#xA;                                    While True&#xA;                                        Dim dLine As String = sr.ReadLine()&#xA;                                        If dLine Is Nothing OrElse dLine = &quot;.&quot; Then Exit While&#xA;                                        If dLine.StartsWith(&quot;..&quot;) Then dLine = dLine.Substring(1)&#xA;                                        sbMime.AppendLine(dLine)&#xA;                                    End While&#xA;                                    SyncLock captureLock&#xA;                                        captured.Add(New System.Tuple(Of System.Collections.Generic.List(Of String), String)(New System.Collections.Generic.List(Of String)(currentRcpts), sbMime.ToString()))&#xA;                                    End SyncLock&#xA;                                    sw.WriteLine(&quot;250 2.0.0 Ok: queued&quot;)&#xA;                                ElseIf upper = &quot;RSET&quot; Then&#xA;                                    currentRcpts = New System.Collections.Generic.List(Of String)()&#xA;                                    sw.WriteLine(&quot;250 2.0.0 Ok&quot;)&#xA;                                ElseIf upper = &quot;NOOP&quot; Then&#xA;                                    sw.WriteLine(&quot;250 2.0.0 Ok&quot;)&#xA;                                ElseIf upper = &quot;QUIT&quot; Then&#xA;                                    sw.WriteLine(&quot;221 2.0.0 Bye&quot;)&#xA;                                    Exit While&#xA;                                Else&#xA;                                    sw.WriteLine(&quot;250 Ok&quot;)&#xA;                                End If&#xA;                            End While&#xA;                        End Using&#xA;                    End Using&#xA;                End Using&#xA;            End Using&#xA;        Catch&#xA;        End Try&#xA;    End While&#xA;End Sub)&#xA;&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_HOST&quot;, &quot;127.0.0.1&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_PORT&quot;, port.ToString(), System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_USER&quot;, &quot;capture@localhost&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_PASSWORD&quot;, &quot;capture-test-pass&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_FROM&quot;, &quot;counselor@jourka.test&quot;, System.EnvironmentVariableTarget.Process)&#xA;System.Environment.SetEnvironmentVariable(&quot;SMTP_SENDER_NAME&quot;, &quot;JourKa Test Runner&quot;, System.EnvironmentVariableTarget.Process)&#xA;&#xA;out_Listener = listener&#xA;out_Cts = cts&#xA;out_ServerTask = serverTask&#xA;out_CapturedMessages = captured&#xA;out_CaptureLockObj = captureLock&#xA;" DisplayName="Setup Isolated Workbook, ForcedZeroByteRole Fixture, and SMTP Capture Server" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="VBNet">
