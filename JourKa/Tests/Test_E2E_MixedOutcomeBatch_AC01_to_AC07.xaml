            <ui:ReadRange Range="{x:Null}" WorkbookPathResource="{x:Null}" AddHeaders="True" DataTable="[dt_AfterRun1]" DisplayName="Read Updated Audit Columns After Run 1" SheetName="Sheet1" WorkbookPath="[tempWorkbookPath]" sap2010:WorkflowViewState.IdRef="ReadRange_1" />
            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Audit Run 1 Captured MIME Envelopes and Row Audit Columns (AC-01..AC-07)&#xA;Dim snapshot As New System.Collections.Generic.List(Of System.Tuple(Of System.Collections.Generic.List(Of String), String))()&#xA;SyncLock in_CaptureLockObj&#xA;    snapshot.AddRange(in_CapturedMessages)&#xA;End SyncLock&#xA;out_CountAfterRun1 = snapshot.Count&#xA;&#xA;Dim decodeHtmlBody As Func(Of String, String) = Function(rawMime As String) As String&#xA;    Dim normalized As String = rawMime.Replace(vbCrLf, vbLf)&#xA;    Dim htmlChunk As String = normalized&#xA;    Dim mHtmlPart As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(normalized, &quot;(?is)Content-Type:\s*text/html[^\n]*\n(.*?)(?:\n--[A-Za-z0-9'()+_,\-./:=?]+|$)&quot;)&#xA;    If mHtmlPart.Success Then htmlChunk = mHtmlPart.Groups(1).Value&#xA;    Dim splitIdx As Integer = htmlChunk.IndexOf(vbLf &amp; vbLf)&#xA;    Dim hdrBlock As String = If(splitIdx &gt;= 0, htmlChunk.Substring(0, splitIdx), &quot;&quot;)&#xA;    Dim bodyBlock As String = If(splitIdx &gt;= 0, htmlChunk.Substring(splitIdx + 2), htmlChunk)&#xA;    If System.Text.RegularExpressions.Regex.IsMatch(hdrBlock, &quot;(?im)Content-Transfer-Encoding:\s*base64&quot;) Then&#xA;        Try&#xA;            Dim b64 As String = System.Text.RegularExpressions.Regex.Replace(bodyBlock, &quot;\s+&quot;, &quot;&quot;)&#xA;            Return System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(b64))&#xA;        Catch&#xA;        End Try&#xA;    ElseIf System.Text.RegularExpressions.Regex.IsMatch(hdrBlock, &quot;(?im)Content-Transfer-Encoding:\s*quoted-printable&quot;) Then&#xA;        Dim qp As String = bodyBlock.Replace(&quot;=&quot; &amp; vbLf, &quot;&quot;)&#xA;        Dim bytesList As New System.Collections.Generic.List(Of Byte)()&#xA;        Dim idx As Integer = 0&#xA;        While idx &lt; qp.Length&#xA;            If qp(idx) = &quot;=&quot;c AndAlso idx + 2 &lt; qp.Length Then&#xA;                Dim hex As String = qp.Substring(idx + 1, 2)&#xA;                Dim bVal As Byte&#xA;                If Byte.TryParse(hex, System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, bVal) Then&#xA;                    bytesList.Add(bVal)&#xA;                    idx += 3&#xA;                    Continue While&#xA;                End If&#xA;            End If&#xA;            bytesList.AddRange(System.Text.Encoding.UTF8.GetBytes(qp(idx).ToString()))&#xA;            idx += 1&#xA;        End While&#xA;        Return System.Text.Encoding.UTF8.GetString(bytesList.ToArray())&#xA;    End If&#xA;    Return bodyBlock&#xA;End Function&#xA;&#xA;Dim extractAttachments As Func(Of String, System.Collections.Generic.List(Of String)) = Function(rawMime As String) As System.Collections.Generic.List(Of String)&#xA;    Dim files As New System.Collections.Generic.List(Of String)()&#xA;    For Each m As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(rawMime, &quot;(?is)filename\s*=\s*&quot;&quot;?([^&quot;&quot;\r\n;]+)&quot;&quot;?&quot;)&#xA;        Dim fn As String = m.Groups(1).Value.Trim()&#xA;        If Not files.Contains(fn, System.StringComparer.OrdinalIgnoreCase) Then files.Add(fn)&#xA;    Next&#xA;    Return files&#xA;End Function&#xA;&#xA;Dim mimeErrs As New System.Collections.Generic.List(Of String)()&#xA;If snapshot.Count &lt;&gt; 5 Then&#xA;    mimeErrs.Add(&quot;Expected 5 captured emails, got &quot; &amp; snapshot.Count.ToString())&#xA;End If&#xA;&#xA;Dim expected As New System.Collections.Generic.List(Of System.Tuple(Of String, String(), String(), String())) From {&#xA;    New System.Tuple(Of String, String(), String(), String())(&quot;Row 2 AC-01&quot;, New String() {&quot;anisa.putri@student.ac.id&quot;}, New String() {&quot;Android Developer - EN.pdf&quot;, &quot;Android Developer - ID.pdf&quot;, &quot;Android Developer - EN.html&quot;, &quot;Android Developer - ID.html&quot;}, New String() {&quot;Dear Anisa Putri and Parent/Guardian,&quot;, &quot;anisa.putri@student.ac.id&quot;}),&#xA;    New System.Tuple(Of String, String(), String(), String())(&quot;Row 3 AC-02/E5&quot;, New String() {&quot;dimas.pratama@school.id&quot;, &quot;parent.pratama@gmail.com&quot;}, New String() {&quot;Video Editor - EN.pdf&quot;, &quot;Video Editor - ID.pdf&quot;, &quot;Video Editor - EN.html&quot;, &quot;Video Editor - ID.html&quot;}, New String() {&quot;Dear Dimas Pratama and Parent/Guardian,&quot;, &quot;Singapore, Malaysia, United Kingdom&quot;, &quot;dimas.pratama@school.id;parent.pratama@gmail.com&quot;}),&#xA;    New System.Tuple(Of String, String(), String(), String())(&quot;Row 4 AC-04&quot;, New String() {&quot;rina.wijaya@mail.com&quot;}, New String() {&quot;Apoteker - EN.pdf&quot;, &quot;Apoteker - ID.pdf&quot;, &quot;Apoteker - EN.html&quot;, &quot;Apoteker - ID.html&quot;}, New String() {&quot;Dear Rina &amp;amp; Wijaya and Parent/Guardian,&quot;, &quot;rina.wijaya@mail.com&quot;}),&#xA;    New System.Tuple(Of String, String(), String(), String())(&quot;Row 5 E6&quot;, New String() {&quot;no.name@student.ac.id&quot;}, New String() {&quot;Mobile Developer - EN.pdf&quot;, &quot;Mobile Developer - ID.pdf&quot;, &quot;Mobile Developer - EN.html&quot;, &quot;Mobile Developer - ID.html&quot;}, New String() {&quot;Dear Valued Student and Parent/Guardian,&quot;, &quot;no.name@student.ac.id&quot;}),&#xA;    New System.Tuple(Of String, String(), String(), String())(&quot;Row 10 AC-07&quot;, New String() {&quot;gamma.ok@student.ac.id&quot;}, New String() {&quot;Mobile Engineer - EN.pdf&quot;, &quot;Mobile Engineer - ID.pdf&quot;, &quot;Mobile Engineer - EN.html&quot;, &quot;Mobile Engineer - ID.html&quot;}, New String() {&quot;Dear Gamma Ok and Parent/Guardian,&quot;, &quot;gamma.ok@student.ac.id&quot;})&#xA;}&#xA;&#xA;For i As Integer = 0 To Math.Min(snapshot.Count, expected.Count) - 1&#xA;    Dim rcpts As System.Collections.Generic.List