          <ui:LogMessage DisplayName="Log Abroad Job Search" sap:VirtualizedContainerService.HintSize="388,92" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;Searching verified abroad entry-level visa-sponsored jobs for: &quot; &amp; resolvedRole &amp; &quot; (Markets from Excel: &quot; &amp; resolvedMarkets &amp; &quot;)&quot;]" />
          <ui:InvokeCode ContinueOnError="{x:Null}" Code="out_AbroadEvidenceText = &quot;&quot;&#xA;out_AbroadCount = 0&#xA;&#xA;Dim resolvedRole As String = If(in_RoleName, &quot;&quot;).Trim()&#xA;Dim resolvedMarkets As String = If(in_AbroadMarkets, &quot;&quot;).Trim()&#xA;&#xA;' If invoked standalone or without arguments, resolve Role &amp; AbroadMarkets directly from Excel DataTable&#xA;If in_dtExcelInput IsNot Nothing AndAlso in_dtExcelInput.Rows.Count &gt; 0 Then&#xA;    For Each r As System.Data.DataRow In in_dtExcelInput.Rows&#xA;        Dim rowJob As String = If(in_dtExcelInput.Columns.Contains(&quot;Job&quot;), Convert.ToString(r(&quot;Job&quot;)).Trim(), &quot;&quot;)&#xA;        Dim rowMkts As String = If(in_dtExcelInput.Columns.Contains(&quot;AbroadMarkets&quot;), Convert.ToString(r(&quot;AbroadMarkets&quot;)).Trim(), &quot;&quot;)&#xA;        If String.IsNullOrWhiteSpace(resolvedRole) AndAlso Not String.IsNullOrWhiteSpace(rowJob) Then&#xA;            resolvedRole = rowJob&#xA;            resolvedMarkets = rowMkts&#xA;            Exit For&#xA;        ElseIf Not String.IsNullOrWhiteSpace(resolvedRole) AndAlso rowJob.Equals(resolvedRole, StringComparison.OrdinalIgnoreCase) Then&#xA;            If String.IsNullOrWhiteSpace(resolvedMarkets) Then resolvedMarkets = rowMkts&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;End If&#xA;&#xA;If String.IsNullOrWhiteSpace(resolvedRole) OrElse String.IsNullOrWhiteSpace(resolvedMarkets) Then&#xA;    Return&#xA;End If&#xA;&#xA;If resolvedMarkets.Equals(&quot;None&quot;, StringComparison.OrdinalIgnoreCase) OrElse resolvedMarkets.Equals(&quot;-&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;    Return&#xA;End If&#xA;&#xA;Dim markets As System.Collections.Generic.List(Of String) = resolvedMarkets.Split(New Char() {&quot;,&quot;c, &quot;;&quot;c}, StringSplitOptions.RemoveEmptyEntries).Select(Function(m) m.Trim()).Where(Function(m) Not String.IsNullOrWhiteSpace(m) AndAlso Not m.Equals(&quot;Indonesia&quot;, StringComparison.OrdinalIgnoreCase) AndAlso Not m.Equals(&quot;None&quot;, StringComparison.OrdinalIgnoreCase) AndAlso Not m.Equals(&quot;-&quot;, StringComparison.OrdinalIgnoreCase)).Distinct(StringComparer.OrdinalIgnoreCase).ToList()&#xA;If markets.Count = 0 Then&#xA;    Return&#xA;End If&#xA;&#xA;' 1. Universal Grammatical &amp; Seniority Stop Words Catalog&#xA;Dim universalGrammarStopWords As New System.Collections.Generic.HashSet(Of String)(New String() {&quot;and&quot;, &quot;or&quot;, &quot;the&quot;, &quot;for&quot;, &quot;with&quot;, &quot;in&quot;, &quot;of&quot;, &quot;to&quot;, &quot;at&quot;, &quot;by&quot;, &quot;from&quot;, &quot;on&quot;, &quot;as&quot;, &quot;a&quot;, &quot;an&quot;, &quot;&amp;&quot;, &quot;/&quot;}, StringComparer.OrdinalIgnoreCase)&#xA;Dim levelStopWords As New System.Collections.Generic.HashSet(Of String)(New String() {&quot;junior&quot;, &quot;jr&quot;, &quot;jr.&quot;, &quot;entry&quot;, &quot;level&quot;, &quot;graduate&quot;, &quot;fresh&quot;, &quot;intern&quot;, &quot;internship&quot;, &quot;trainee&quot;, &quot;associate&quot;, &quot;apprentice&quot;}, StringComparer.OrdinalIgnoreCase)&#xA;&#xA;' 2. Fully Dynamic English Translation for Non-English Input Roles (Zero Hardcoding)&#xA;Dim englishRole As String = resolvedRole&#xA;Using transClient As New System.Net.Http.HttpClient()&#xA;    transClient.Timeout = TimeSpan.FromSeconds(5)&#xA;    transClient.DefaultRequestHeaders.Add(&quot;User-Agent&quot;, &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64)&quot;)&#xA;    Try&#xA;        Dim transUrl As String = &quot;https://translate.googleapis.com/translate_a/single?client=gtx&amp;sl=auto&amp;tl=en&amp;dt=t&amp;q=&quot; &amp; Uri.EscapeDataString(resolvedRole)&#xA;        Dim transRaw As String = transClient.GetStringAsync(transUrl).GetAwaiter().GetResult()&#xA;        Dim mTrans As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(transRaw, &quot;^\[\[\[&quot;&quot;([^&quot;&quot;]+)&quot;&quot;&quot;)&#xA;        If mTrans.Success AndAlso Not String.IsNullOrWhiteSpace(mTrans.Groups(1).Value) Then&#xA;            englishRole = mTrans.Groups(1).Value.Trim()&#xA;        End If&#xA;    Catch&#xA;        englishRole = resolvedRole&#xA;    End Try&#xA;End Using&#xA;&#xA;' 3. Fully Dynamic Linguistic Role Decomposition (Zero Static Catalog)&#xA;' Extracts clean tokens from englishRole, resolvedRole, and in_ExtraKeywords&#xA;Dim cleanTokens As New System.Collections.Generic.List(Of String)()&#xA;For Each tok As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(englishRole, &quot;[A-Za-z0-9#\+]{2,}&quot;)&#xA;    Dim w As String = tok.Value.Trim()&#xA;    If Not universalGrammarStopWords.Contains(w) AndAlso Not levelStopWords.Contains(w) AndAlso Not cleanTokens.Contains(w, StringComparer.OrdinalIgnoreCase) Then&#xA;        cleanTokens.Add(w)&#xA;    End If&#xA;Next&#xA;If cleanTokens.Count = 0 Then&#xA;    For Each tok As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(resolvedRole, &quot;[A-Za-z0-9#\+]{2,}&quot;)&#xA;        Dim w As String = tok.Value.Trim()&#xA;        If Not universalGrammarStopWords.Contains(w) AndAlso Not levelStopWords.Contains(w) AndAlso Not cleanTokens.Contains(w, StringComparer.OrdinalIgnoreCase) Then&#xA;            cleanTokens.Add(w)&#xA;        End If&#xA;    Next&#xA;End If&#xA;&#xA;' Natural Language Job Title Heuristic:&#xA;' In English &amp; Indonesian, compound job titles follow [Domain Specifiers] + [Head Discipline Noun]&#xA;' e.g. &quot;Video Editor&quot;, &quot;Android Developer&quot;, &quot;Tax Consultant&quot;, &quot;Flight Attendant&quot;, &quot;Dental Hygienist&quot;&#xA;Dim domainTokens As New System.Collections.Generic.List(Of String)()&#xA;Dim roleDisciplines As New System.Collections.Generic.List(Of String)()&#xA;Dim domainPhrase As String = &quot;&quot;&#xA;&#xA;If cleanTokens.Count &lt;= 1 Then&#xA;    ' Single-word role (e.g. Pharmacist, Chef, Architect)&#xA;    If cleanTokens.Count = 1 Then&#xA;        domainTokens.Add(cleanTokens(0))&#xA;        roleDisciplines.Add(cleanTokens(0))&#xA;        domainPhrase = cleanTokens(0)&#xA;    End If&#xA;Else&#xA;    ' Compound role: the terminal word is the functional discipline, preceding words are domain specifiers&#xA;    Dim lastIdx As Integer = cleanTokens.Count - 1&#xA;    Dim headToken As String = cleanTokens(lastIdx)&#xA;    roleDisciplines.Add(headToken)&#xA;    &#xA;    Dim dList As New System.Collections.Generic.List(Of String)()&#xA;    For i As Integer = 0 To lastIdx - 1&#xA;        dList.Add(cleanTokens(i))&#xA;        domainTokens.Add(cleanTokens(i))&#xA;    Next&#xA;    domainPhrase = String.Join(&quot; &quot;, dList).Trim()&#xA;End If&#xA;&#xA;' Also incorporate non-English resolvedRole tokens and extra keywords into domainTokens&#xA;Dim extraSource As String = (If(resolvedRole.Equals(englishRole, StringComparison.OrdinalIgnoreCase), &quot;&quot;, resolvedRole) &amp; &quot; &quot; &amp; If(in_ExtraKeywords, &quot;&quot;)).Trim()&#xA;If Not String.IsNullOrWhiteSpace(extraSource) Then&#xA;    For Each tok As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(extraSource, &quot;[A-Za-z0-9#\+]{2,}&quot;)&#xA;        Dim w As String = tok.Value.Trim()&#xA;        If Not universalGrammarStopWords.Contains(w) AndAlso Not levelStopWords.Contains(w) AndAlso Not roleDisciplines.Contains(w, StringComparer.OrdinalIgnoreCase) AndAlso Not domainTokens.Contains(w, StringComparer.OrdinalIgnoreCase) Then&#xA;            domainTokens.Add(w)&#xA;        End If&#xA;    Next&#xA;End If&#xA;&#xA;' Dynamic stop words and primary anchors for THIS role&#xA;Dim dynamicStopWords As New System.Collections.Generic.HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;For Each w As String In universalGrammarStopWords: dynamicStopWords.Add(w): Next&#xA;For Each w As String In levelStopWords: dynamicStopWords.Add(w): Next&#xA;For Each rd As String In roleDisciplines: dynamicStopWords.Add(rd): Next&#xA;&#xA;Dim primaryAnchors As New System.Collections.Generic.List(Of String)()&#xA;If Not String.IsNullOrWhiteSpace(domainPhrase) Then&#xA;    primaryAnchors.Add(domainPhrase)&#xA;End If&#xA;For Each dt As String In domainTokens&#xA;    If Not primaryAnchors.Contains(dt, StringComparer.OrdinalIgnoreCase) Then primaryAnchors.Add(dt)&#xA;Next&#xA;If primaryAnchors.Count = 0 Then&#xA;    For Each rd As String In roleDisciplines&#xA;        If Not primaryAnchors.Contains(rd, StringComparer.OrdinalIgnoreCase) Then primaryAnchors.Add(rd)&#xA;    Next&#xA;End If&#xA;&#xA;' 4. Dynamic Senior Title Exclusion Filter (exempt words if the role itself contains them, e.g. Product Manager or System Architect)&#xA;Dim seniorWords As New System.Collections.Generic.List(Of String)()&#xA;For Each sw As String In New String() {&quot;senior&quot;, &quot;sr&quot;, &quot;sr\.&quot;, &quot;lead&quot;, &quot;principal&quot;, &quot;staff&quot;, &quot;head&quot;, &quot;director&quot;, &quot;vp&quot;, &quot;vice\s+president&quot;, &quot;expert&quot;, &quot;distinguished&quot;, &quot;iii&quot;, &quot;iv&quot;, &quot;architect&quot;, &quot;manager&quot;}&#xA;    Dim matchesRoleWord As Boolean = False&#xA;    For Each tok As String In cleanTokens&#xA;        If sw.Equals(tok, StringComparison.OrdinalIgnoreCase) OrElse sw.StartsWith(tok, StringComparison.OrdinalIgnoreCase) Then&#xA;            matchesRoleWord = True&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;    If Not matchesRoleWord Then seniorWords.Add(sw)&#xA;Next&#xA;Dim rxSeniorTitle As New System.Text.RegularExpressions.Regex(&quot;(?i)\b(&quot; &amp; String.Join(&quot;|&quot;, seniorWords) &amp; &quot;)\b&quot;)&#xA;&#xA;Dim rxSeniorExp As New System.Text.RegularExpressions.Regex(&quot;(?i)(\b([3-9]|1\d)\+?\s*(years|yrs)\s+(of\s+)?(professional\s+|relevant\s+|commercial\s+|industry\s+|hands-on\s+|practical\s+|work\s+)?experience\b|(minimum|at\s+least)\s+([3-9]|1\d)\+?\s*(years|yrs))&quot;)&#xA;Dim rxSponsorPos As New System.Text.RegularExpressions.Regex(&quot;(?i)(visa\s+sponsorship|visa\s+(and\s+relocation\s+)?(support|assistance)|sponsor(ship)?\s+(of\s+)?(your\s+|a\s+|the\s+)?(work\s+)?(visa|permit)|we\s+(will|can|do|also)?\s*sponsor\s+(visas?|work\s+permits?|eligible\s+candidates)|relocation\s+(package|support|assistance)\s+(incl\w*|and|with)\s+(visa|work\s+permit)|work\s+permit\s+(support|assistance|sponsorship)|(eu\s+)?blue\s+card\s+(support|sponsorship|assistance)|employment\s+pass\s+(sponsorship|support)|skilled\s+worker\s+visa\s+(sponsorship|support))&quot;)&#xA;Dim rxSponsorNeg As New System.Text.RegularExpressions.Regex(&quot;(?i)(no\s+visa\s+sponsorship|(not|unable\s+to|cannot|can't|don't|do\s+not)\s+(provide\s+|offer\s+|support\s+)?(visa\s+)?sponsor|(do\s+not|don't|not)\s+require\s+([a-z0-9_'’\-\s]{0,30})?(visa\s+)?sponsorship|prioriti[sz](e|ing)\s+applicants\s+who\s+have\s+(a\s+)?(current\s+)?right\s+to\s+work|without\s+(the\s+need\s+for\s+)?(visa\s+)?sponsorship|sponsorship\s+is\s+not\s+(available|offered)|must\s+(already\s+)?(have|hold|possess)\s+(the\s+|a\s+|valid\s+)?(right|authori[sz]ation|permit|visa)\s+to\s+work|citizens?\s+(or|and)\s+(permanent\s+)?residents?\s+only)&quot;)&#xA;Dim rxSalary As New System.Text.RegularExpressions.Regex(&quot;(?i)(\b[A-Z]{3}\b|\u20AC|\$|\u00A3|\u00A5|\u20A9|\u20B9|CHF|HK\$|NT\$|S\$|A\$|C\$|RM)\s?\d[\d,\.]*\s*(k|K|M|m|per\s+year|p\.a\.|/yr|/month|-\s*([A-Z]{3}|\u20AC|\$|\u00A3|\u00A5|\u20A9|\u20B9|CHF|HK\$|NT\$|S\$|A\$|C\$|RM)?\s*\d[\d,\.]*[kKmM]?)?&quot;)&#xA;&#xA;' 5. Smarter Dynamic Relevance Function (Zero Hardcoding)&#xA;Dim isRelevant As Func(Of String, Boolean) = Function(titleText As String) As Boolean&#xA;    If String.IsNullOrWhiteSpace(titleText) Then Return False&#xA;    If titleText.IndexOf(resolvedRole, StringComparison.OrdinalIgnoreCase) &gt;= 0 Then Return True&#xA;    If Not String.IsNullOrWhiteSpace(englishRole) AndAlso titleText.IndexOf(englishRole, StringComparison.OrdinalIgnoreCase) &gt;= 0 Then Return True&#xA;    If Not String.IsNullOrWhiteSpace(domainPhrase) AndAlso titleText.IndexOf(domainPhrase, StringComparison.OrdinalIgnoreCase) &gt;= 0 Then Return True&#xA;    If domainTokens.Count = 1 Then&#xA;        Dim dt As String = domainTokens(0)&#xA;        If dt.Length &lt;= 3 Then&#xA;            If System.Text.RegularExpressions.Regex.IsMatch(titleText, &quot;(?i)\b&quot; &amp; System.Text.RegularExpressions.Regex.Escape(dt) &amp; &quot;\b&quot;) Then Return True&#xA;        Else&#xA;            If titleText.IndexOf(dt, StringComparison.OrdinalIgnoreCase) &gt;= 0 Then Return True&#xA;        End If&#xA;    ElseIf domainTokens.Count &gt; 1 Then&#xA;        Dim allMatch As Boolean = True&#xA;        For Each dt As String In domainTokens&#xA;            If dt.Length &lt;= 3 Then&#xA;                If Not System.Text.RegularExpressions.Regex.IsMatch(titleText, &quot;(?i)\b&quot; &amp; System.Text.RegularExpressions.Regex.Escape(dt) &amp; &quot;\b&quot;) Then&#xA;                    allMatch = False&#xA;                    Exit For&#xA;                End If&#xA;            Else&#xA;                If titleText.IndexOf(dt, StringComparison.OrdinalIgnoreCase) &lt; 0 Then&#xA;                    allMatch = False&#xA;                    Exit For&#xA;                End If&#xA;            End If&#xA;        Next&#xA;        If allMatch Then Return True&#xA;    End If&#xA;    Return False&#xA;End Function&#xA;&#xA;Dim verifiedLines As New System.Collections.Generic.List(Of String)()&#xA;Dim seenIds As New System.Collections.Generic.HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;Dim seenCompTitle As New System.Collections.Generic.HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;Dim detailFetchCount As Integer = 0&#xA;Dim maxDetailFetches As Integer = 30&#xA;Dim maxVerified As Integer = 8&#xA;&#xA;Using client As New System.Net.Http.HttpClient()&#xA;    client.Timeout = TimeSpan.FromSeconds(45)&#xA;    client.DefaultRequestHeaders.Add(&quot;User-Agent&quot;, &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64)&quot;)&#xA;&#xA;    ' 1. Query LinkedIn Guest Search strictly for each country in Excel AbroadMarkets&#xA;    For Each mkt As String In markets&#xA;        If verifiedLines.Count &gt;= maxVerified OrElse detailFetchCount &gt;= maxDetailFetches Then Exit For&#xA;&#xA;        ' Dynamic LinkedIn queries for this role and its dynamic English translation&#xA;        Dim searchQueries As New System.Collections.Generic.List(Of String)()&#xA;        searchQueries.Add(resolvedRole &amp; &quot; visa sponsorship&quot;)&#xA;        searchQueries.Add(&quot;Junior &quot; &amp; resolvedRole &amp; &quot; visa sponsorship&quot;)&#xA;        If Not String.IsNullOrWhiteSpace(englishRole) AndAlso Not englishRole.Equals(resolvedRole, StringComparison.OrdinalIgnoreCase) Then&#xA;            Dim eq1 As String = englishRole &amp; &quot; visa sponsorship&quot;&#xA;            Dim eq2 As String = &quot;Junior &quot; &amp; englishRole &amp; &quot; visa sponsorship&quot;&#xA;            If Not searchQueries.Contains(eq1, StringComparer.OrdinalIgnoreCase) Then searchQueries.Add(eq1)&#xA;            If Not searchQueries.Contains(eq2, StringComparer.OrdinalIgnoreCase) Then searchQueries.Add(eq2)&#xA;        End If&#xA;&#xA;        For Each sq As String In searchQueries&#xA;            If verifiedLines.Count &gt;= maxVerified OrElse detailFetchCount &gt;= maxDetailFetches Then Exit For&#xA;            Dim liUrl As String = &quot;https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=&quot; &amp; Uri.EscapeDataString(sq) &amp; &quot;&amp;location=&quot; &amp; Uri.EscapeDataString(mkt) &amp; &quot;&amp;f_E=1%2C2&amp;start=0&quot;&#xA;            Dim liHtml As String = &quot;&quot;&#xA;            Try&#xA;                Dim resp As System.Net.Http.HttpResponseMessage = client.GetAsync(liUrl).GetAwaiter().GetResult()&#xA;                If CInt(resp.StatusCode) = 429 Then&#xA;                    System.Threading.Thread.Sleep(5000)&#xA;                    resp = client.GetAsync(liUrl).GetAwaiter().GetResult()&#xA;                    If CInt(resp.StatusCode) = 429 Then&#xA;                        System.Threading.Thread.Sleep(1200)&#xA;                        Exit For&#xA;                    End If&#xA;                End If&#xA;                If resp.IsSuccessStatusCode Then&#xA;                    liHtml = resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;                End If&#xA;            Catch&#xA;            End Try&#xA;            System.Threading.Thread.Sleep(1200)&#xA;            If String.IsNullOrWhiteSpace(liHtml) Then Continue For&#xA;&#xA;            Dim cardMatches As System.Text.RegularExpressions.MatchCollection = System.Text.RegularExpressions.Regex.Matches(liHtml, &quot;(?s)data-entity-urn=&quot;&quot;urn:li:jobPosting:(\d+)&quot;&quot;\s*.*?base-search-card__title[^&gt;]*&gt;\s*([^&lt;]+?)\s*&lt;/h3&gt;\s*.*?base-search-card__subtitle[^&gt;]*&gt;\s*(?:&lt;a[^&gt;]*&gt;)?\s*([^&lt;]+?)\s*(?:&lt;/a&gt;)?\s*&lt;/h4&gt;\s*.*?job-search-card__location[^&gt;]*&gt;\s*([^&lt;]+?)\s*&lt;/span&gt;&quot;)&#xA;            Dim cardIdx As Integer = 0&#xA;            For Each cm As System.Text.RegularExpressions.Match In cardMatches&#xA;                If verifiedLines.Count &gt;= maxVerified OrElse detailFetchCount &gt;= maxDetailFetches OrElse cardIdx &gt;= 10 Then Exit For&#xA;                cardIdx += 1&#xA;                Dim jId As String = cm.Groups(1).Value.Trim()&#xA;                Dim jTitle As String = System.Net.WebUtility.HtmlDecode(cm.Groups(2).Value.Trim())&#xA;                Dim jComp As String = System.Net.WebUtility.HtmlDecode(cm.Groups(3).Value.Trim())&#xA;                Dim jLoc As String = System.Net.WebUtility.HtmlDecode(cm.Groups(4).Value.Trim())&#xA;                Dim dedupeKey As String = jComp &amp; &quot;|&quot; &amp; jTitle&#xA;                If seenIds.Contains(jId) OrElse seenCompTitle.Contains(dedupeKey) Then Continue For&#xA;                seenIds.Add(jId)&#xA;&#xA;                If Not isRelevant(jTitle) OrElse rxSeniorTitle.IsMatch(jTitle) Then Continue For&#xA;&#xA;                detailFetchCount += 1&#xA;                Dim detailHtml As String = &quot;&quot;&#xA;                Try&#xA;                    Dim dResp As System.Net.Http.HttpResponseMessage = client.GetAsync(&quot;https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/&quot; &amp; jId).GetAwaiter().GetResult()&#xA;                    If CInt(dResp.StatusCode) = 429 Then&#xA;                        System.Threading.Thread.Sleep(5000)&#xA;                        dResp = client.GetAsync(&quot;https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/&quot; &amp; jId).GetAwaiter().GetResult()&#xA;                    End If&#xA;                    If dResp.IsSuccessStatusCode Then&#xA;                        detailHtml = dResp.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;                    End If&#xA;                Catch&#xA;                End Try&#xA;                System.Threading.Thread.Sleep(1200)&#xA;                If String.IsNullOrWhiteSpace(detailHtml) Then Continue For&#xA;&#xA;                Dim dm As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(detailHtml, &quot;(?s)show-more-less-html__markup[^&gt;]*&gt;(.*?)&lt;/div&gt;&quot;)&#xA;                If Not dm.Success Then Continue For&#xA;                Dim rawDesc As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(dm.Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot; &quot;))&#xA;                rawDesc = System.Text.RegularExpressions.Regex.Replace(rawDesc, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;&#xA;                If rxSeniorExp.IsMatch(rawDesc) OrElse rxSponsorNeg.IsMatch(rawDesc) Then Continue For&#xA;                Dim posMatch As System.Text.RegularExpressions.Match = rxSponsorPos.Match(rawDesc)&#xA;          