        End Try&#xA;            System.Threading.Thread.Sleep(1200)&#xA;            If String.IsNullOrWhiteSpace(anJson) Then Exit For&#xA;&#xA;            Try&#xA;                Dim rootObj As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(anJson)&#xA;                Dim dataArr As Newtonsoft.Json.Linq.JArray = TryCast(rootObj(&quot;data&quot;), Newtonsoft.Json.Linq.JArray)&#xA;                If dataArr Is Nothing OrElse dataArr.Count = 0 Then Exit For&#xA;                For Each item As Newtonsoft.Json.Linq.JToken In dataArr&#xA;                    If verifiedLines.Count &gt;= maxVerified Then Exit For&#xA;                    Dim jTitle As String = If(item(&quot;title&quot;) IsNot Nothing, item(&quot;title&quot;).ToString().Trim(), &quot;&quot;)&#xA;                    Dim jComp As String = If(item(&quot;company_name&quot;) IsNot Nothing, item(&quot;company_name&quot;).ToString().Trim(), &quot;&quot;)&#xA;                    Dim jLoc As String = If(item(&quot;location&quot;) IsNot Nothing, item(&quot;location&quot;).ToString().Trim(), &quot;&quot;)&#xA;                    Dim jUrl As String = If(item(&quot;url&quot;) IsNot Nothing, item(&quot;url&quot;).ToString().Trim(), &quot;&quot;)&#xA;                    Dim jSlug As String = If(item(&quot;slug&quot;) IsNot Nothing, item(&quot;slug&quot;).ToString().Trim(), jUrl)&#xA;                    If String.IsNullOrWhiteSpace(jTitle) OrElse String.IsNullOrWhiteSpace(jUrl) OrElse String.IsNullOrWhiteSpace(jLoc) Then Continue For&#xA;&#xA;                    ' Strictly require the posting location or description to match a country in Excel AbroadMarkets&#xA;                    Dim matchedMkt As String = markets.FirstOrDefault(Function(m) jLoc.IndexOf(m, StringComparison.OrdinalIgnoreCase) &gt;= 0)&#xA;                    If String.IsNullOrWhiteSpace(matchedMkt) Then Continue For&#xA;&#xA;                    Dim dedupeKey As String = jComp &amp; &quot;|&quot; &amp; jTitle&#xA;                    If se