    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Using client As New System.Net.Http.HttpClient()&#xA;    client.Timeout = TimeSpan.FromSeconds(90)&#xA;    Dim sysPrompt As String = &quot;You are a senior tech career researcher and mentor. Transform the raw scraped job-board skillset data ([J01]..[J08]) and YouTube daily routine data ([Y01]..[Y08]) into a comprehensive, easy-to-read GitHub-Flavored Markdown career dossier for an entry-level candidate covering: 1. Role Description, 2. Entry-Level Skillset &amp; Tech Stack Demand, 3. What You Need to Learn &amp; Portfolio Projects, 4. Realistic Daily Routine, 5. Expected Starting Salaries in Indonesia, 6. Real Pros, Real Cons &amp; Honest Industry Realities, 7. First 30/60/90-Day Plan, 8. Verified Evidence &amp; Source Register. Never fabricate URLs.&quot;&#xA;    Dim usrPrompt As String = &quot;ROLE: &quot; &amp; in_RoleName &amp; Environment.NewLine &amp; &quot;LEVEL: &quot; &amp; in_RoleLevel &amp; Environment.NewLine &amp; &quot;MARKET: &quot; &amp; in_RoleLocation &amp; Environment.NewLine &amp; &quot;KEYWORDS: &quot; &amp; in_ExtraKeywords &amp; Environment.NewLine &amp; &quot;JOB EVIDENCE:&quot; &amp; Environment.NewLine &amp; in_JobEvidenceText &amp; Environment.NewLine &amp; &quot;YOUTUBE EVIDENCE:&quot; &amp; Environment.NewLine &amp; in_YoutubeEvidenceText&#xA;    Dim reqJson As String = &quot;{&quot;&quot;system_instruction&quot;&quot;:{&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(sysPrompt) &amp; &quot;}]},&quot;&quot;contents&quot;&quot;:[{&quot;&quot;role&quot;&quot;:&quot;&quot;user&quot;&quot;,&quot;&quot;parts&quot;&quot;:[{&quot;&quot;text&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.SerializeObject(usrPrompt) &amp; &quot;}]}],&quot;&quot;generationConfig&quot;&quot;:{&quot;&quot;temperature&quot;&quot;:0.25}}&quot;&#xA;    out_DossierMarkdown = &quot;&quot;&#xA;    For Each mdl As String In New String() {&quot;gemini-3.5-flash&quot;, &quot;gemini-3.8-flash&quot;, &quot;gemini-3.1-flash-lite&quot;, &quot;gemini-3.5-flash-lite&quot;}&#xA;        Try&#xA;            Dim ep As String = &quot;https://generativelanguage.googleapis.com/v1beta/models/&quot; &amp; mdl &amp; &quot;:generateContent&quot;&#xA;            Dim reqMsg As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, ep)&#xA;            reqMsg.Headers.Add(&quot;x-goog-api-key&quot;, in_GeminiApiKey)&#xA;            reqMsg.Content = New System.Net.Http.StringContent(reqJson, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;            Dim respMsg As System.Net.Http.HttpResponseMessage = client.SendAsync(reqMsg).GetAwaiter().GetResult()&#xA;            Dim respBody As String = respMsg.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;            If respMsg.IsSuccessStatusCode Then&#xA;                out_DossierMarkdown = Newtonsoft.Json.Linq.JObject.Parse(respBody)(&quot;candidates&quot;)(0)(&quot;content&quot;)(&quot;parts&quot;)(0)(&quot;text&quot;).ToString().Trim()&#xA;                If Not String.IsNullOrWhiteSpace(out_DossierMarkdown) Then Exit For&#xA;            End If&#xA;        Catch&#xA;        End Try&#xA;    Next&#xA;    If String.IsNullOrWhiteSpace(out_DossierMarkdown) Then&#xA;        out_DossierMarkdown = &quot;# 1. Entry-Level Career Dossier: &quot; &amp; in_RoleName &amp; &quot; (&quot; &amp; in_RoleLocation &amp; &quot;)&quot; &amp; Environment.NewLine &amp; Environment.NewLine &amp; in_JobEvidenceText &amp; Environment.NewLine &amp; Environment.NewLine &amp; in_YoutubeEvidenceText&#xA;    End If&#xA;End Using" DisplayName="Call Google AI Studio generateContent" sap:VirtualizedContainerService.HintSize="388,165" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="VBNet">
