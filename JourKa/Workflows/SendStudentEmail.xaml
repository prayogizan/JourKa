          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Validate inputs, verify attachments, and load SMTP credentials from .env or Environment Variables (JK-RPA-007 / #27)&#xA;If String.IsNullOrWhiteSpace(in_NormalizedRecipients) Then&#xA;    Throw New System.ArgumentException(&quot;in_NormalizedRecipients cannot be blank.&quot;, &quot;in_NormalizedRecipients&quot;)&#xA;End If&#xA;If String.IsNullOrWhiteSpace(in_Subject) Then&#xA;    Throw New System.ArgumentException(&quot;in_Subject cannot be blank.&quot;, &quot;in_Subject&quot;)&#xA;End If&#xA;If String.IsNullOrWhiteSpace(in_BodyHtml) Then&#xA;    Throw New System.ArgumentException(&quot;in_BodyHtml cannot be blank.&quot;, &quot;in_BodyHtml&quot;)&#xA;End If&#xA;&#xA;Dim cleanAttachments As New System.Collections.Generic.List(Of String)()&#xA;If in_AttachmentPaths IsNot Nothing Then&#xA;    For Each rawPath As String In in_AttachmentPaths&#xA;        If Not String.IsNullOrWhiteSpace(rawPath) Then&#xA;            Dim trimmedPath As String = rawPath.Trim()&#xA;            If Not System.IO.File.Exists(trimmedPath) Then&#xA;                Throw New System.IO.FileNotFoundException(&quot;Email attachment not found: &quot; &amp; trimmedPath, trimmedPath)&#xA;            End If&#xA;            Dim fi As New System.IO.FileInfo(trimmedPath)&#xA;            If fi.Length &lt;= 0 Then&#xA;                Throw New System.IO.FileNotFoundException(&quot;Email attachment is 0 bytes: &quot; &amp; trimmedPath, trimmedPath)&#xA;            End If&#xA;            If Not cleanAttachments.Contains(trimmedPath, System.StringComparer.OrdinalIgnoreCase) Then&#xA;                cleanAttachments.Add(trimmedPath)&#xA;            End If&#xA;        End If&#xA;    Next&#xA;End If&#xA;If cleanAttachments.Count = 0 Then&#xA;    Throw New System.ArgumentException(&quot;At least one non-empty attachment path is required.&quot;, &quot;in_AttachmentPaths&quot;)&#xA;End If&#xA;out_ValidAttachments = cleanAttachments&#xA;&#xA;' Load .env values (project dir first, then parent repo root) without overriding non-empty process env vars&#xA;Dim envValues As New System.Collections.Generic.Dictionary(Of String, String)(System.StringComparer.OrdinalIgnoreCase)&#xA;Dim envCandidates As String() = New String() {&#xA;    System.IO.Path.GetFullPath(System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;..&quot;, &quot;.env&quot;)),&#xA;    System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;.env&quot;)&#xA;}&#xA;For Each envPath As String In envCandidates&#xA;    If System.IO.File.Exists(envPath) Then&#xA;        For Each rawLine As String In System.IO.File.ReadAllLines(envPath, System.Text.Encoding.UTF8)&#xA;            Dim line As String = rawLine.Trim()&#xA;            If String.IsNullOrWhiteSpace(line) OrElse line.StartsWith(&quot;#&quot;) Then Continue For&#xA;            If line.StartsWith(&quot;export &quot;, System.StringComparison.OrdinalIgnoreCase) Then&#xA;                line = line.Substring(7).Trim()&#xA;            End If&#xA;            Dim eqIdx As Integer = line.IndexOf(&quot;=&quot;c)&#xA;            If eqIdx &lt;= 0 Then Continue For&#xA;            Dim k As String = line.Substring(0, eqIdx).Trim()&#xA;            Dim v As String = line.Substring(eqIdx + 1).Trim()&#xA;            If v.Length &gt;= 2 AndAlso ((v.StartsWith(&quot;&quot;&quot;&quot;) AndAlso v.EndsWith(&quot;&quot;&quot;&quot;)) OrElse (v.StartsWith(&quot;'&quot;) AndAlso v.EndsWith(&quot;'&quot;))) Then&#xA;                v = v.Substring(1, v.Length - 2)&#xA;            End If&#xA;            If Not String.IsNullOrWhiteSpace(k) Then&#xA;                envValues(k) = v&#xA;            End If&#xA;        Next&#xA;    End If&#xA;Next&#xA;&#xA;Dim getSetting As Func(Of String, String) = Function(keyName As String) As String&#xA;    If envValues.ContainsKey(keyName) AndAlso Not String.IsNullOrWhiteSpace(envValues(keyName)) Then&#xA;        Return envValues(keyName).Trim()&#xA;    End If&#xA;    Dim procVal As String = System.Environment.GetEnvironmentVariable(keyName, System.EnvironmentVariableTarget.Process)&#xA;    If Not String.IsNullOrWhiteSpace(procVal) Then Return procVal.Trim()&#xA;    Dim userVal As String = System.Environment.GetEnvironmentVariable(keyName, System.EnvironmentVariableTarget.User)&#xA;    If Not String.IsNullOrWhiteSpace(userVal) Then Return userVal.Trim()&#xA;    Return &quot;&quot;&#xA;End Function&#xA;&#xA;Dim hostVal As String = getSetting(&quot;SMTP_HOST&quot;)&#xA;Dim portText As String = getSetting(&quot;SMTP_PORT&quot;)&#xA;Dim userVal2 As String = getSetting(&quot;SMTP_USER&quot;)&#xA;Dim passVal As String = getSetting(&quot;SMTP_PASSWORD&quot;)&#xA;Dim fromVal As String = getSetting(&quot;SMTP_FROM&quot;)&#xA;Dim senderNameVal As String = getSetting(&quot;SMTP_SENDER_NAME&quot;)&#xA;&#xA;If String.IsNullOrWhiteSpace(hostVal) Then&#xA;    Throw New System.InvalidOperationException(&quot;Missing SMTP_HOST configuration in .env or environment variables.&quot;)&#xA;End If&#xA;If String.IsNullOrWhiteSpace(userVal2) Then&#xA;    Throw New System.InvalidOperationException(&quot;Missing SMTP_USER configuration in .env or environment variables.&quot;)&#xA;End If&#xA;If String.IsNullOrWhiteSpace(passVal) Then&#xA;    Throw New System.InvalidOperationException(&quot;Missing SMTP_PASSWORD configuration in .env or environment variables.&quot;)&#xA;End If&#xA;&#xA;Dim parsedPort As Integer = 587&#xA;If Not String.IsNullOrWhiteSpace(portText) Then&#xA;    If Not Integer.TryParse(portText, parsedPort) OrElse parsedPort &lt;= 0 OrElse parsedPort &gt; 65535 Then&#xA;        Throw New System.InvalidOperationException(&quot;Invalid SMTP_PORT value: '&quot; &amp; portText &amp; &quot;'. Expected integer 1..65535.&quot;)&#xA;    End If&#xA;End If&#xA;&#xA;out_SmtpHost = hostVal&#xA;out_SmtpPort = parsedPort&#xA;out_SmtpUser = userVal2&#xA;out_SmtpFrom = If(String.IsNullOrWhiteSpace(fromVal), userVal2, fromVal)&#xA;out_SmtpSenderName = If(String.IsNullOrWhiteSpace(senderNameVal), &quot;JourKa Career Intelligence&quot;, senderNameVal)&#xA;out_SmtpPasswordPlain = passVal&#xA;" DisplayName="Validate Inputs and Load Secured SMTP Credentials" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="VBNet">
