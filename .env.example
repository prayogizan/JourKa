# JourKa Environment Configuration Template
# Copy this file to `.env` (git-ignored) in the repository root or `JourKa/.env`
# and populate with real credentials. Never commit `.env` or real secrets.

# Google Gemini API (used by Main.xaml InvokeCode_1 for bilingual dossier generation)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Mail Dispatch Configuration (used by Workflows/SendStudentEmail.xaml)
# For Gmail with App Password: host=smtp.gmail.com, port=587
# For Outlook/Office 365: host=smtp.office365.com, port=587
# Orchestrator Assets alternative: JourKa_SMTP_Host, JourKa_SMTP_Port, JourKa_SMTP_Credential
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=counselor@example.com
SMTP_PASSWORD=your_smtp_app_password_here

# Optional sender overrides (defaults: SMTP_FROM=SMTP_USER, SMTP_SENDER_NAME=JourKa Career Intelligence)
SMTP_FROM=counselor@example.com
SMTP_SENDER_NAME=JourKa Career Intelligence
